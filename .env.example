# Copia este archivo a .env (local) o configura estas variables en Vercel → Settings → Environment Variables.
# El endpoint /api/lead entrega cada solicitud por TODOS los canales configurados. Con ninguno configurado,
# en desarrollo responde ok (delivered:false) y en producción responde 503.

# Resend: envía el lead por correo a info@ionoshub.net
RESEND_API_KEY=
# Remitente verificado en Resend (opcional). Por defecto: "IonosHub Web <onboarding@resend.dev>"
LEAD_FROM=

# Webhook heredado de v1 (n8n u otro). Recibe el JSON del lead por POST.
LEAD_WEBHOOK_URL=
