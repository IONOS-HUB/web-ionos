# Copia este archivo a .env (local) o configura estas variables en Vercel → Settings → Environment Variables.
# El endpoint /api/lead reenvía cada solicitud del formulario al webhook de n8n. Sin la variable,
# en desarrollo responde ok (delivered:false) y en producción responde 503.

# Webhook de n8n (producción). Recibe el JSON del lead por POST y lo registra en el CRM.
LEAD_WEBHOOK_URL=

# GoHighLevel (CRM). URL del trigger "Inbound Webhook" de un Workflow de GHL:
#   GHL → Automation → Workflows → Create → trigger "Inbound Webhook" → copiar la URL aquí.
# Recibe TODOS los leads (formulario, chat IONIC, webinars y landings /speed-to-lead) con campos ya
# aplanados (first_name, email, phone en E.164, tags, utm_*…). Mapeo en docs/SPEED-TO-LEAD.md.
# Con las dos variables, cada lead va a n8n y a GHL; basta que uno lo acepte. Sólo servidor.
GHL_WEBHOOK_URL=

# ── Analítica y buscadores (prefijo PUBLIC_: se incrustan en el HTML; sin valor no se emite nada) ──
# Google Analytics 4. Por defecto el sitio usa G-0Q8D7W836K; esta variable lo sobreescribe. GA sólo carga con consentimiento.
PUBLIC_GA_MEASUREMENT_ID=
# Search Console → Verificación por etiqueta HTML: sólo el valor de content="…"
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Verificación por etiqueta meta: sólo el valor de content="…"
PUBLIC_BING_SITE_VERIFICATION=

# ── Meta (Facebook / Instagram Ads) · sólo landings /speed-to-lead. Guía: docs/META-PIXEL.md ──
# ID del conjunto de datos (Pixel). Por defecto el sitio usa 1472397644734399 (META_PIXEL_ID en src/lib/site.ts);
# esta variable lo sobreescribe. Público: se incrusta en el HTML.
PUBLIC_META_PIXEL_ID=
# Token de la API de Conversiones: Administrador de eventos → tu Pixel → Configuración → API de Conversiones
# → "Generar token de acceso". Sólo servidor. Sin él, sólo mide el Pixel del navegador.
META_CAPI_TOKEN=
# Sólo para probar: el código de "Probar eventos" (TEST12345). Bórralo al terminar o los leads no cuentan.
META_TEST_EVENT_CODE=
# Verificación del dominio: Configuración del negocio → Seguridad de la marca → Dominios → Metaetiqueta:
# sólo el valor de content="…". Va en todas las páginas (Meta la busca en la portada).
PUBLIC_META_DOMAIN_VERIFICATION=

# ── Cuestionarios para clientes (/cuestionario). Guía: docs/CUESTIONARIOS.md ──
# Clave del enlace genérico (sin ?c=): frena envíos masivos. El enlace personal de GHL no la pide. Sólo servidor.
# Sin ella, en producción el enlace genérico queda cerrado (503); en desarrollo acepta cualquier clave.
CUESTIONARIO_CLAVE=
# Webhook de n8n del flujo «Cuestionarios → PRD (Drive + GHL)»: https://n8n.ionoshub.net/webhook/cuestionario-web
CUESTIONARIO_WEBHOOK_URL=
# Clave compartida con n8n (header x-ionos-key). Debe ser igual a `webhook_key` en la data table
# `cuestionario_web_config` de n8n; si no coincide, n8n responde 401 y no genera nada.
CUESTIONARIO_WEBHOOK_KEY=
# Opcional. Webhook que lee el contacto de GHL para el enlace personal (?c=). Si falta, se deduce de
# CUESTIONARIO_WEBHOOK_URL: https://n8n.ionoshub.net/webhook/cuestionario-contacto
CUESTIONARIO_CONTACTO_URL=

# Webhook de n8n que recibe los leads del formulario y del chat.
# ── Agente IONIC del sitio (endpoint /api/chat) ──
# Clave de Google AI Studio. Sólo servidor; nunca se expone al navegador.
GEMINI_API_KEY=
# Modelo. Por defecto gemini-2.5-flash-lite (el más barato con salida estructurada).
GEMINI_MODEL=
# Secreto para firmar la sesión del chat (HMAC). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CHAT_SECRET=
# Interruptor: ponlo en 0 para apagar el chat sin desplegar.
CHAT_ENABLED=

# Oculta la burbuja del agente IONIC si vale 0. Cualquier otro valor (o sin definir) la muestra.
# Para cortar además el endpoint del chat, usa CHAT_ENABLED=0.
PUBLIC_CHAT_UI=

# ── Freno por IP compartido entre instancias (opcional pero recomendado) ──
# Upstash Redis por HTTPS: capa gratuita, sólo estas dos credenciales. Sin ellas el freno
# funciona igual, pero cada instancia de la función lleva su propia cuenta.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
