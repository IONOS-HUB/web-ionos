---
/**
 * Galería de trabajo real dentro de una ventanilla del sistema (fotos de cobertura o capturas de sistemas).
 *
 * Movimiento con tesis: "revelado y entrega". Al entrar en pantalla cada pieza se revela de negativo hielo
 * borroso a nítida, en cascada, y al final aparece la tarjeta de entrega (la promesa del servicio). Clic abre
 * un visor con zoom continuo desde la miniatura. `prefers-reduced-motion` y `?nomotion=1` muestran el estado
 * final sin animar (el reveal reutiliza el observador de motion.ts vía data-reveal).
 *
 * `variant="screen"`: cada pieza va en un marco de navegador en miniatura (barra con tres puntos y el nombre del cliente).
 * `compact`: una sola fila sin ventanilla (home).
 */
import Icon from './Icon.astro';
import { srcsetFor } from '../lib/images';
import type { Gallery } from '../data/photos';

interface Props {
  gallery: Gallery;
  variant?: 'photo' | 'screen';
  compact?: boolean;
  class?: string;
}
const { gallery, variant = 'photo', compact = false, class: className = '' } = Astro.props;
const screen = variant === 'screen';
const items = compact ? gallery.items.slice(0, screen ? 4 : 5) : gallery.items;
const lead = !compact && !!gallery.lead;

/* Retícula del mosaico: fotos 4 columnas con la primera a doble celda; pantallas 2 (sm) / 3 (lg) columnas. */
const gridClass = screen
  ? items.length === 4
    ? 'grid-cols-1 sm:grid-cols-2'
    : 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3'
  : 'grid-cols-2 sm:grid-cols-4 sm:grid-rows-2';

const tileShape = (i: number) => {
  if (screen) return 'aspect-video';
  if (lead && i === 0) return 'tile-lead aspect-[4/3] sm:aspect-auto sm:h-full';
  return 'aspect-square';
};
---

<div class:list={['gallery', className]} data-gallery>
  {
    compact ? (
      <ul class:list={['grid gap-2 sm:gap-3', screen ? 'grid-cols-2 sm:grid-cols-4' : 'grid-cols-3 sm:grid-cols-5']} aria-label={gallery.title}>
        {items.map((p, i) => (
          <li class:list={[(screen ? i > 1 : i > 2) && 'hidden sm:block']}>
            <button
              type="button"
              class:list={['tile rounded-[1rem]', screen ? 'tile-screen aspect-video' : 'aspect-[4/5]']}
              data-reveal
              data-reveal-delay={i * 110}
              aria-label={`Ampliar: ${p.alt}`}
            >
              {screen && (
                <span class="bar" aria-hidden="true">
                  <i /><i /><i />
                  <span class="url">{p.label}</span>
                </span>
              )}
              <span class="media">
                <img src={p.src} srcset={srcsetFor(p.src, p.width)} sizes="(min-width: 640px) 18vw, 30vw" alt={p.alt} width={p.width} height={p.height} loading="lazy" decoding="async" />
              </span>
            </button>
          </li>
        ))}
      </ul>
    ) : (
      <div class="overflow-hidden rounded-[1.5rem] border border-line bg-canvas shadow-lift">
        <div class="flex items-center justify-between gap-3 bg-cobalt px-4 py-3 text-white">
          <div class="flex min-w-0 items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15"><Icon name={screen ? 'software' : 'image'} size={18} /></span>
            <div class="min-w-0 leading-tight">
              <p class="truncate text-[0.95rem] font-semibold">{gallery.header.title}</p>
              <p class="truncate text-xs text-ice">{gallery.header.subtitle}</p>
            </div>
          </div>
          <span class="shrink-0 rounded-full border border-white/30 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-ice">{gallery.badge}</span>
        </div>

        <ul class:list={['grid gap-2 p-2 sm:gap-3 sm:p-3', gridClass]} aria-label={gallery.title}>
          {items.map((p, i) => (
            <li class:list={[lead && i === 0 && 'col-span-2 row-span-2']}>
              <button
                type="button"
                class:list={['tile rounded-[0.75rem]', screen && 'tile-screen', tileShape(i)]}
                data-reveal
                data-reveal-delay={i * 140}
                aria-label={`Ampliar: ${p.alt}`}
              >
                {screen && (
                  <span class="bar" aria-hidden="true">
                    <i /><i /><i />
                    <span class="url">{p.label}</span>
                  </span>
                )}
                <span class="media">
                  <img
                    src={p.src}
                    srcset={srcsetFor(p.src, p.width)}
                    sizes={lead && i === 0 ? '(min-width: 1024px) 44vw, 92vw' : '(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 92vw'}
                    alt={p.alt}
                    width={p.width}
                    height={p.height}
                    loading={i === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                </span>
                {i === 0 && gallery.delivery && (
                  <span class="delivery pointer-events-none absolute bottom-3 left-3 flex items-center gap-3 rounded-2xl border border-ice-2 bg-ice-3/95 px-3.5 py-2.5 text-left backdrop-blur" data-reveal data-reveal-delay="900">
                    <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cobalt text-white"><Icon name="check" size={16} /></span>
                    <span class="leading-tight">
                      <span class="block text-[0.85rem] font-semibold text-cobalt-ink">{gallery.delivery.title}</span>
                      <span class="block text-[0.78rem] text-ink-3">{gallery.delivery.detail}</span>
                    </span>
                  </span>
                )}
              </button>
            </li>
          ))}
        </ul>

        <div class="flex items-center justify-between gap-3 border-t border-line-soft bg-ice-3 px-4 py-3">
          <p class="text-[0.72rem] font-semibold uppercase tracking-wide text-ink-3">{gallery.footer.caption}</p>
          <p class="tnum shrink-0 text-[0.78rem] text-ink-2">{items.length} {gallery.footer.unit} · clic para ampliar</p>
        </div>
      </div>
    )
  }

  <dialog class="lb" aria-label={`Visor: ${gallery.title}`}>
    <figure class="lb-fig">
      <img class="lb-img" src={items[0].src} alt={items[0].alt} width={items[0].width} height={items[0].height} decoding="async" />
      <figcaption class="lb-cap">
        <span class="lb-text"></span>
        <span class="lb-count tnum"></span>
      </figcaption>
    </figure>
    <button type="button" class="lb-btn lb-prev" aria-label="Anterior"><Icon name="arrow-right" size={20} class="rotate-180" /></button>
    <button type="button" class="lb-btn lb-next" aria-label="Siguiente"><Icon name="arrow-right" size={20} /></button>
    <button type="button" class="lb-btn lb-close" aria-label="Cerrar visor"><Icon name="close" size={20} /></button>
  </dialog>
</div>

<style>
  /* ── Mosaico ─────────────────────────────────────────────────────── */
  .tile {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--color-ice-2);
    border: 1px solid var(--color-line);
    cursor: zoom-in;
    -webkit-tap-highlight-color: transparent;
  }
  .tile:focus-visible {
    outline: 3px solid var(--color-cobalt);
    outline-offset: 3px;
  }
  .media {
    position: absolute;
    inset: 0;
    display: block;
    transition: transform 0.7s var(--ease-out-expo);
  }
  .media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Marco de navegador en miniatura: barra con tres puntos y el nombre del cliente como "dirección" */
  .tile-screen .bar {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    height: 1.5rem;
    padding: 0 0.6rem;
    background: var(--color-ice-3);
    border-bottom: 1px solid var(--color-line-soft);
  }
  .tile-screen .bar i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-line);
  }
  .tile-screen .url {
    margin-left: 0.35rem;
    max-width: 70%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--color-canvas);
    font-size: 0.62rem;
    font-weight: 600;
    line-height: 1rem;
    letter-spacing: 0.01em;
    color: var(--color-ink-3);
  }
  .tile-screen .media {
    top: 1.5rem;
  }
  .tile-screen .media img {
    object-position: top;
  }
  /* Brillo de impresión al pasar el cursor: un barrido de luz sobre la copia */
  .tile::after {
    content: '';
    position: absolute;
    inset: -20%;
    z-index: 2;
    background: linear-gradient(115deg, transparent 42%, rgb(255 255 255 / 0.28) 50%, transparent 58%);
    transform: translateX(-70%);
    pointer-events: none;
  }
  @media (hover: hover) {
    .tile:hover .media {
      transform: scale(1.04);
    }
    .tile:hover::after {
      transform: translateX(70%);
      transition: transform 0.9s var(--ease-out-expo);
    }
  }

  /* Revelado: el observador de motion.ts añade .is-in; sin motion-ready todo está ya revelado. */
  :global(html.motion-ready) .tile[data-reveal]:not(.is-in) {
    opacity: 1;
    transform: none;
    filter: none;
  }
  :global(html.motion-ready) .tile[data-reveal]:not(.is-in) .media {
    clip-path: inset(0 0 100% 0);
    filter: blur(16px) saturate(0.1) brightness(1.2);
    transform: scale(1.1);
  }
  :global(html.motion-ready) .tile[data-reveal].is-in .media {
    clip-path: inset(0 0 0 0);
    filter: blur(0) saturate(1) brightness(1);
    transform: scale(1);
    transition:
      clip-path 0.9s var(--ease-out-expo),
      filter 1.2s var(--ease-out-expo),
      transform 1.3s var(--ease-out-expo);
  }
  :global(html.motion-ready) .tile[data-reveal].is-in:hover .media {
    transform: scale(1.04);
  }
  :global(html.motion-ready) .delivery[data-reveal]:not(.is-in) {
    transform: translateY(12px) scale(0.96);
  }

  /* Parallax de la pieza principal guiado por el scroll (progresivo; sin él, imagen fija) */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .tile-lead .media img {
        animation: drift linear both;
        animation-timeline: view();
        animation-range: entry 0% exit 100%;
      }
    }
  }
  @keyframes drift {
    from { transform: translateY(-5%) scale(1.12); }
    to { transform: translateY(5%) scale(1.12); }
  }

  /* ── Visor ───────────────────────────────────────────────────────── */
  .lb {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fff;
    display: none;
    place-items: center;
  }
  .lb[open] {
    display: grid;
  }
  .lb::backdrop {
    background: rgb(11 27 51 / 0.9);
  }
  .lb[open]::backdrop {
    animation: lb-fade 0.4s var(--ease-out-expo) both;
  }
  @keyframes lb-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  .lb-fig {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    margin: 0;
    padding: 0 1rem;
  }
  .lb-img {
    max-width: min(92vw, 72rem);
    max-height: 76vh;
    width: auto;
    height: auto;
    border-radius: 1.5rem;
    border: 1px solid rgb(255 255 255 / 0.2);
    box-shadow: var(--shadow-phone);
    transform-origin: center;
    will-change: transform;
  }
  .lb-cap {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    max-width: min(92vw, 72rem);
    font-size: 0.92rem;
    color: var(--color-night-text);
    text-wrap: pretty;
  }
  .lb-count {
    flex-shrink: 0;
    font-weight: 600;
    color: #fff;
  }
  .lb-btn {
    position: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
    cursor: pointer;
    transition: background-color 0.25s, transform 0.35s var(--ease-out-expo);
  }
  .lb-btn:hover {
    background: rgb(255 255 255 / 0.22);
    transform: translateY(-2px);
  }
  .lb-btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }
  .lb-close { top: 1rem; right: 1rem; }
  .lb-prev { left: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 1rem; top: 50%; transform: translateY(-50%); }
  .lb-prev:hover { transform: translateY(-50%) translateX(-2px); }
  .lb-next:hover { transform: translateY(-50%) translateX(2px); }
  @media (max-width: 639px) {
    .lb-prev, .lb-next { top: auto; bottom: 1rem; transform: none; }
    .lb-prev { left: 1rem; }
    .lb-next { right: 1rem; }
    .lb-prev:hover, .lb-next:hover { transform: none; }
  }
</style>

<script>
  // Visor con zoom continuo (FLIP) desde la miniatura pulsada. Una instancia por galería en la página.
  const EXPO = 'cubic-bezier(0.16, 1, 0.3, 1)';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const tiles = Array.from(root.querySelectorAll<HTMLButtonElement>('.tile'));
    const dialog = root.querySelector<HTMLDialogElement>('dialog.lb');
    if (!dialog || tiles.length === 0) continue;
    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const text = dialog.querySelector<HTMLElement>('.lb-text')!;
    const count = dialog.querySelector<HTMLElement>('.lb-count')!;
    const photos = tiles.map((t) => {
      const i = t.querySelector('img')!;
      return { src: i.getAttribute('src')!, alt: i.alt };
    });
    let index = 0;
    let seq = 0; // generación de carga: descarta una foto que llegue tarde tras pulsar varias veces

    const cancelAnims = () => img.getAnimations().forEach((a) => a.cancel());

    // Transformación que lleva la imagen del visor a la caja de la miniatura (y viceversa).
    const flip = (from: DOMRect, to: DOMRect) => {
      if (!to.width || !to.height) return 'none';
      const sx = from.width / to.width;
      const sy = from.height / to.height;
      const dx = from.left + from.width / 2 - (to.left + to.width / 2);
      const dy = from.top + from.height / 2 - (to.top + to.height / 2);
      return `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`;
    };

    const load = async (i: number) => {
      index = (i + photos.length) % photos.length;
      const mine = ++seq;
      img.src = photos[index].src;
      img.alt = photos[index].alt;
      text.textContent = photos[index].alt;
      count.textContent = `${index + 1} / ${photos.length}`;
      try {
        await img.decode();
      } catch {}
      return mine === seq;
    };

    const open = async (i: number) => {
      if (dialog.open) return;
      await load(i);
      if (dialog.open) return;
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
      if (reduced) return;
      cancelAnims();
      const from = tiles[index].querySelector('img')!.getBoundingClientRect();
      const to = img.getBoundingClientRect();
      img.animate(
        [
          { transform: flip(from, to), borderRadius: '0.75rem', opacity: 0.85 },
          { transform: 'none', borderRadius: '1.5rem', opacity: 1 },
        ],
        { duration: 560, easing: EXPO },
      );
      dialog.querySelector('.lb-cap')!.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], {
        duration: 420,
        delay: 260,
        easing: EXPO,
        fill: 'backwards',
      });
    };

    const close = () => {
      if (!dialog.open) return;
      const finish = () => {
        if (!dialog.open) return;
        cancelAnims();
        dialog.close();
        document.documentElement.style.overflow = '';
        tiles[index].focus({ preventScroll: true });
      };
      if (reduced) return finish();
      cancelAnims();
      const to = tiles[index].querySelector('img')!.getBoundingClientRect();
      const from = img.getBoundingClientRect();
      const anim = img.animate(
        [
          { transform: 'none', borderRadius: '1.5rem', opacity: 1 },
          { transform: flip(to, from), borderRadius: '0.75rem', opacity: 0.4 },
        ],
        { duration: 380, easing: EXPO, fill: 'forwards' },
      );
      anim.onfinish = finish;
      // Red de seguridad: si la pestaña está en segundo plano la animación no avanza, pero el visor debe cerrarse igual.
      window.setTimeout(finish, 450);
    };

    const step = async (dir: 1 | -1) => {
      if (!dialog.open) return;
      cancelAnims();
      const current = await load(index + dir);
      if (!current || reduced) return;
      img.animate([{ opacity: 0, transform: `translateX(${dir * 28}px)` }, { opacity: 1, transform: 'none' }], { duration: 420, easing: EXPO });
    };

    tiles.forEach((t, i) => t.addEventListener('click', () => open(i)));
    dialog.querySelector('.lb-close')!.addEventListener('click', close);
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => step(-1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => step(1));
    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
      // Escape también aquí: algunos navegadores ignoran preventDefault en `cancel` y cerrarían sin la animación.
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });
    let touchX = 0;
    dialog.addEventListener('touchstart', (e) => (touchX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 48) step(dx < 0 ? 1 : -1);
    });
  }
</script>
