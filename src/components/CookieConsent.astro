---
/**
 * Consentimiento de cookies con Google Consent Mode v2.
 * - Sin elección: sólo cookies necesarias; GA4 no se carga.
 * - "Aceptar todo" o analítica activada en "Personalizar": se actualiza el consentimiento y se carga gtag.js.
 * - La elección se guarda en localStorage (`ionoshub-consent`) y se puede cambiar desde "Preferencias de cookies" en el pie.
 * - Con `metaPixelId` (sólo las landings de pauta) aparece además "Publicidad · Meta": el Pixel sólo se
 *   carga si se acepta. En las páginas sin Pixel esa elección no se toca, se conserva la anterior.
 */
import Icon from './Icon.astro';

interface Props {
  gaId: string;
  metaPixelId?: string;
}
const { gaId, metaPixelId = '' } = Astro.props;
---

<!--
  No es un `dialog`: es una región no modal. Un `role="dialog"` obliga a atrapar el foco y a cerrar con
  Escape, y este aviso no hace ni debe hacer ninguna de las dos en la primera visita (Escape equivaldría a
  consentir en silencio). En móvil es una barra compacta: la versión anterior medía 348 px y sepultaba los
  dos CTA del hero, que caen entre 513 y 629 px en 375x812.
-->
<div
  class="cc fixed inset-x-0 bottom-0 z-[90] border-t border-line bg-canvas p-3.5 shadow-phone sm:inset-x-auto sm:bottom-6 sm:left-6 sm:max-w-lg sm:rounded-[1.5rem] sm:border sm:p-6"
  role="region"
  aria-labelledby="cc-title"
  hidden
  data-cookie-consent
>
  <div class="flex items-start gap-3">
    <span class="hidden h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ice text-cobalt-ink sm:flex"><Icon name="shield" size={18} /></span>
    <div class="min-w-0">
      <p class="hidden text-[1.05rem] font-semibold leading-tight text-ink sm:block">Tu privacidad, tu decisión.</p>
      <!--
        En móvil el texto va a dos líneas y el detalle vive en "Personalizar" y en la política: cada
        línea de más empuja la barra hacia arriba y se come los CTA de la página.
      -->
      <p id="cc-title" class="text-[0.82rem] leading-snug text-ink-2 sm:mt-1.5 sm:text-[0.92rem] sm:leading-relaxed">
        Cookies para que el sitio funcione y, si lo permites, {metaPixelId ? 'analítica y publicidad' : 'analítica'}.{' '}
        <span class="hidden sm:inline">Así sabemos qué páginas ayudan más. Nunca vendemos tus datos.{' '}</span>
        <a href="/politica-de-privacidad" class="font-semibold text-cobalt-ink underline underline-offset-2">Política de privacidad</a>
      </p>
    </div>
  </div>

  <div class="cc-prefs mt-4 divide-y divide-line-soft rounded-[1rem] border border-line" hidden>
    <label class="flex items-center justify-between gap-4 px-4 py-3">
      <span>
        <span class="block text-[0.95rem] font-semibold text-ink">Necesarias</span>
        <span class="block text-[0.82rem] text-ink-3">Formulario, seguridad y tus preferencias. Siempre activas.</span>
      </span>
      <input type="checkbox" checked disabled class="cc-switch" aria-label="Cookies necesarias, siempre activas" />
    </label>
    <label class="flex items-center justify-between gap-4 px-4 py-3">
      <span>
        <span class="block text-[0.95rem] font-semibold text-ink">Analítica · Google Analytics 4</span>
        <span class="block text-[0.82rem] text-ink-3">Páginas vistas, hasta dónde bajas, clics a WhatsApp y redes, y si envías el formulario. Agregado y con IP anonimizada; nunca lo que escribes.</span>
      </span>
      <input type="checkbox" class="cc-switch" data-cc-analytics aria-label="Permitir Google Analytics" />
    </label>
    {
      metaPixelId && (
        <label class="flex items-center justify-between gap-4 px-4 py-3">
          <span>
            <span class="block text-[0.95rem] font-semibold text-ink">Publicidad · Meta Pixel</span>
            <span class="block text-[0.82rem] text-ink-3">
              Le dice a Meta (Facebook e Instagram) que llegaste por un anuncio y si enviaste la solicitud, para medir y mejorar nuestras campañas. Tus datos de contacto van cifrados.
            </span>
          </span>
          <input type="checkbox" class="cc-switch" data-cc-ads aria-label="Permitir Meta Pixel" />
        </label>
      )
    }
  </div>

  <!--
    Dos botones y dos enlaces, no cuatro botones: "Personalizar" pasa a enlace para que el punto de
    decisión quede en dos opciones y la barra quepa en una fila de 375 px.
  -->
  <div class="mt-2.5 flex flex-wrap items-center gap-x-2 gap-y-1 sm:mt-4">
    <button type="button" class="btn btn-primary !min-h-11 !px-4 text-[0.95rem] sm:!px-5" data-cc-accept>Aceptar</button>
    <button type="button" class="btn btn-ghost !min-h-11 !px-4 text-[0.95rem] sm:!px-5" data-cc-necessary>Sólo necesarias</button>
    <button type="button" class="btn btn-primary !min-h-11 !px-4 text-[0.95rem] sm:!px-5" data-cc-save hidden>Guardar preferencias</button>
    <button
      type="button"
      class="ml-auto inline-flex min-h-11 items-center px-1 text-[0.82rem] font-semibold text-cobalt-ink underline underline-offset-2"
      data-cc-customize>Personalizar</button>
  </div>
</div>

<style>
  .cc-switch {
    appearance: none;
    width: 2.75rem;
    height: 1.6rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-ice-2);
    position: relative;
    cursor: pointer;
    transition: background-color 0.25s;
  }
  .cc-switch::after {
    content: '';
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 999px;
    background: var(--color-canvas);
    box-shadow: 0 1px 3px rgb(15 23 34 / 0.2);
    transition: transform 0.3s var(--ease-out-expo);
  }
  .cc-switch:checked {
    background: var(--color-cobalt);
  }
  .cc-switch:checked::after {
    transform: translateX(1.15rem);
  }
  .cc-switch:disabled {
    cursor: default;
    opacity: 0.6;
  }
  .cc-switch:focus-visible {
    outline: 3px solid var(--color-cobalt);
    outline-offset: 3px;
  }
  .cc:not([hidden]) {
    animation: msg-in 0.55s var(--ease-out-expo) both;
  }
  /* En móvil el aviso ocupa todo el ancho: la columna de botones flotantes sube para no quedar tapada. */
  @media (max-width: 639px) {
    /* Desplazamiento en px calculado en JS (alto del aviso + 20 px): el minificador aplana calc() con var(). */
    :global(html.cc-open [data-float-stack]) {
      translate: 0 var(--cc-shift, 0px);
      transition: translate 0.5s var(--ease-out-expo);
    }
    /* Nada del documento queda inalcanzable bajo la barra. Es `padding-bottom`: el documento crece por
       abajo y no mueve nada de lo ya pintado, así que no cuenta como CLS (a diferencia de tocar `bottom`). */
    :global(html.cc-open body) {
      padding-bottom: var(--cc-height, 0px);
    }
  }
</style>

<script is:inline define:vars={{ gaId, metaPixelId }}>
  (() => {
    const KEY = 'ionoshub-consent';
    const box = document.querySelector('[data-cookie-consent]');
    if (!box) return;
    const prefs = box.querySelector('.cc-prefs');
    const analyticsInput = box.querySelector('[data-cc-analytics]');
    const adsInput = box.querySelector('[data-cc-ads]');
    const saveBtn = box.querySelector('[data-cc-save]');
    const customizeBtn = box.querySelector('[data-cc-customize]');

    // Consent Mode v2: todo denegado por defecto; gtag.js sólo se carga si la analítica se permite.
    window.dataLayer = window.dataLayer || [];
    window.gtag = window.gtag || function () { dataLayer.push(arguments); };
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });

    let gaLoaded = false;
    const loadGa = () => {
      if (gaLoaded || !gaId) return;
      gaLoaded = true;
      const s = document.createElement('script');
      s.async = true;
      s.src = `https://www.googletagmanager.com/gtag/js?id=${gaId}`;
      document.head.appendChild(s);
      gtag('js', new Date());
      gtag('config', gaId, { anonymize_ip: true });
    };

    // Meta Pixel: el código base oficial, pero sólo cuando la persona acepta la publicidad.
    let pixelLoaded = false;
    const loadPixel = () => {
      if (pixelLoaded || !metaPixelId) return;
      pixelLoaded = true;
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', metaPixelId);
      fbq('track', 'PageView');
    };

    const read = () => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || 'null');
      } catch {
        return null;
      }
    };
    const apply = (analytics, ads) => {
      gtag('consent', 'update', { analytics_storage: analytics ? 'granted' : 'denied' });
      if (analytics) loadGa();
      // Lo lee el formulario de las landings para decidir si el servidor manda el Lead a Meta.
      window.ionosAdsConsent = !!(ads && metaPixelId);
      if (ads) loadPixel();
      // Retirar el permiso con el Pixel ya cargado: deja de enviar desde ahora.
      else if (pixelLoaded) fbq('consent', 'revoke');
    };
    const root = document.documentElement;
    // El alto del aviso llega por ResizeObserver (sin forzar layout desde JS); cubre fuente tardía y resize.
    const setLift = (h) => {
      root.style.setProperty('--cc-lift', `${Math.round(h) + 44}px`);
      root.style.setProperty('--cc-shift', `-${Math.round(h) + 20}px`);
      root.style.setProperty('--cc-height', `${Math.round(h)}px`);
    };
    if ('ResizeObserver' in window) {
      new ResizeObserver((entries) => {
        const h = entries[0].borderBoxSize?.[0]?.blockSize ?? entries[0].contentRect.height;
        if (!box.hidden && h) setLift(h);
      }).observe(box);
    }
    /**
     * La medida inicial se toma siempre, no sólo cuando falta ResizeObserver: hay navegadores donde
     * `ResizeObserver` existe pero no entrega callbacks, y entonces --cc-shift se quedaba sin fijar y
     * los botones flotantes no subían. El observer sigue, pero para los cambios posteriores
     * (al desplegar "Personalizar"), no para el primero.
     */
    const lift = () => requestAnimationFrame(() => setLift(box.offsetHeight));

    const save = (analytics, ads) => {
      // Sin Pixel en la página no se preguntó por la publicidad: se conserva lo que se eligió antes.
      if (!metaPixelId) ads = !!(read() || {}).ads;
      try {
        localStorage.setItem(KEY, JSON.stringify({ necessary: true, analytics, ads, at: new Date().toISOString(), v: 2 }));
      } catch {}
      if (ads && pixelLoaded) fbq('consent', 'grant');
      apply(analytics, ads);
      box.hidden = true;
      root.classList.remove('cc-open');
      // El aviso se oculta con el foco dentro: sin esto el foco vuelve al body y se pierde el sitio.
      if (opener) opener.focus();
      opener = null;
    };

    // Quién abrió el aviso desde el pie, para devolverle el foco al cerrar con Escape.
    let opener = null;

    // `focus` sólo cuando lo abre la persona desde el pie: en la primera visita no se roba el foco
    // (y se evita un reflow forzado en plena carga).
    const open = (focus) => {
      const saved = read();
      analyticsInput.checked = !!(saved && saved.analytics);
      if (adsInput) adsInput.checked = !!(saved && saved.ads);
      prefs.hidden = true;
      saveBtn.hidden = true;
      customizeBtn.hidden = false;
      box.hidden = false;
      root.classList.add('cc-open');
      lift();
      if (focus) box.querySelector('[data-cc-accept]').focus({ preventScroll: true });
    };

    box.querySelector('[data-cc-accept]').addEventListener('click', () => save(true, true));
    box.querySelector('[data-cc-necessary]').addEventListener('click', () => save(false, false));
    customizeBtn.addEventListener('click', () => {
      prefs.hidden = false;
      saveBtn.hidden = false;
      customizeBtn.hidden = true;
      lift();
      analyticsInput.focus({ preventScroll: true });
    });
    saveBtn.addEventListener('click', () => save(analyticsInput.checked, !!(adsInput && adsInput.checked)));

    // Reapertura desde el pie ("Preferencias de cookies")
    document.querySelectorAll('[data-cookie-prefs]').forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        open(true);
      }),
    );

    // Escape cierra sólo cuando ya hay una elección guardada, es decir cuando lo reabrió la persona desde
    // el pie. En la primera visita no se cierra: irse con Escape equivaldría a consentir en silencio.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || box.hidden || !read()) return;
      box.hidden = true;
      root.classList.remove('cc-open');
      if (opener) opener.focus();
      opener = null;
    });

    const saved = read();
    if (saved) apply(!!saved.analytics, !!(metaPixelId && saved.ads));
    // Quien eligió antes de que existiera la categoría de publicidad aún no respondió a ella.
    if (!saved || (metaPixelId && saved.ads === undefined)) {
      // Primera visita: el aviso aparece cuando el hilo principal queda libre, fuera de la ruta crítica.
      const show = () => open(false);
      if ('requestIdleCallback' in window) requestIdleCallback(show, { timeout: 1500 });
      else setTimeout(show, 400);
    }

    // Clics a WhatsApp como evento de contacto (sólo llega a GA si hay consentimiento)
    document.addEventListener('click', (e) => {
      const a = e.target instanceof Element ? e.target.closest('a[href*="wa.me"]') : null;
      if (!a) return;
      gtag('event', 'contact_whatsapp', { link_text: a.textContent.trim().slice(0, 60), page_path: location.pathname });
      if (pixelLoaded && window.ionosAdsConsent) fbq('track', 'Contact');
    });
  })();
</script>
