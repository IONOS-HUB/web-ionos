---
/**
 * Ventanilla de demostración por sector. Misma anatomía que el resto del sistema (cabecera cobalto
 * con disco de icono y badge "Demostración", cuerpo blanco con filas divididas, pie en hielo 3), pero
 * el guion, las etiquetas de quién habla y el canal salen del nicho.
 *
 * CONTENIDO DEMOSTRATIVO: los negocios son ficticios y la interfaz lo dice. No son clientes reales.
 */
import Icon from '../Icon.astro';
import type { Niche } from '../../data/niches';

interface Props {
  niche: Niche;
  /** El selector del eje monta las cuatro y alterna cuál se ve */
  hidden?: boolean;
  id?: string;
}
const { niche, hidden = false, id } = Astro.props;
const { demo } = niche;
const esLlamada = demo.channel === 'Llamada';
const canalIcono = esLlamada ? 'phone' : demo.channel === 'Instagram' ? 'instagram' : 'whatsapp';

/* Alturas de la onda de audio: sólo decoran la llamada, nunca representan un dato. */
const bars = [3, 6, 9, 14, 8, 12, 16, 10, 6, 11, 15, 9, 5, 8, 12, 7, 4, 9, 13, 6, 3, 7, 10, 5];
---

<div
  class="overflow-hidden rounded-[1.5rem] border border-line bg-canvas shadow-lift"
  aria-label={`Demostración: IONIC en ${niche.label.toLowerCase()}`}
  data-niche-demo={niche.id}
  id={id}
  hidden={hidden}
>
  <div class="flex items-center justify-between gap-3 bg-cobalt px-4 py-3 text-white">
    <div class="flex min-w-0 items-center gap-3">
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15"><Icon name={canalIcono} size={18} /></span>
      <div class="min-w-0 leading-tight">
        <p class="truncate text-[0.95rem] font-semibold">{demo.channel} · {demo.business}</p>
        <p class="truncate text-xs text-ice">{demo.meta}</p>
      </div>
    </div>
    <span class="shrink-0 rounded-full border border-white/30 px-2.5 py-1 text-[0.72rem] font-semibold uppercase tracking-wide text-ice">Demostración</span>
  </div>

  {
    esLlamada && (
      <div class="wave-live flex h-12 items-end gap-[3px] border-b border-line-soft bg-ice-3 px-4 pb-2" aria-hidden="true">
        {bars.map((h, i) => (
          <span class:list={['wave-bar w-1 rounded-full', i % 3 === 0 ? 'bg-cobalt' : 'bg-cobalt-glow/60']} style={`height:${h * 2}px`} />
        ))}
        <span class="ml-auto self-center text-[0.72rem] font-medium text-ink-3">Transcripción en vivo</span>
      </div>
    )
  }

  <ol class="flex flex-col gap-2 px-4 py-4">
    {
      demo.lines.map((line) => (
        <li class:list={['flex flex-col gap-0.5', line.who === 'ionic' ? 'items-end' : 'items-start']}>
          <span class="px-1 text-[0.72rem] font-semibold uppercase tracking-wide text-ink-3">
            {line.who === 'ionic' ? demo.speakers.ionic : demo.speakers.client}
          </span>
          <p class:list={['max-w-[88%] px-3.5 py-2 text-[0.95rem] leading-snug', line.who === 'ionic' ? 'bubble-out' : 'bubble-in']}>
            {line.text}
          </p>
        </li>
      ))
    }
    <li class="mt-1 flex items-center gap-3 self-end rounded-2xl border border-ice-2 bg-ice-3 px-3.5 py-2.5">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cobalt text-white"><Icon name="check" size={14} /></span>
      <div class="leading-tight">
        <p class="text-[0.82rem] font-semibold text-cobalt-ink">{demo.card.title}</p>
        <p class="text-[0.72rem] text-ink-3">{demo.card.detail}</p>
      </div>
    </li>
  </ol>

  <!-- El pie es la línea roja: es lo que diferencia un agente del sector de un chatbot con otro saludo. -->
  <div class="border-t border-line-soft bg-ice-3 px-4 py-3">
    <p class="text-[0.72rem] font-semibold uppercase tracking-wide text-ink-3">Lo que no hace</p>
    <p class="mt-1 text-[0.82rem] leading-snug text-ink-2">{niche.redLines[0]}.</p>
  </div>
</div>
