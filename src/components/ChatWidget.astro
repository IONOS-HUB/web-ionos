---
/**
 * Burbuja de conversación con IONIC. Sin React a propósito: son unos pocos KB de JavaScript propio,
 * así el chat no obliga a cargar el runtime en páginas que hoy no lo usan (blog, casos, equipo).
 *
 * El lanzador va dentro de [data-float-stack] (encima del flotante de WhatsApp) y el panel es fijo,
 * fuera de esa columna. Toda la lógica delicada vive en /api/chat.
 *
 * Diseño: cada respuesta lleva el robot al lado y las burbujas tienen forma de nube con punta, para
 * que se vea de un golpe quién habla y que quien responde es una IA, no una persona del equipo.
 */
import Icon from './Icon.astro';
import { GREETING } from '../lib/chat/copy';
import { waLink, CALENDAR_URL } from '../lib/site';

const sugerencias = ['¿Qué hacen exactamente?', '¿Cómo atiende llamadas la IA?', 'Quiero agendar'];
---

<div
  id="cw-panel"
  class="cw-panel flex-col overflow-hidden"
  role="dialog"
  aria-labelledby="cw-title"
  hidden
  data-chat-panel
>
  <header class="cw-head">
    <span class="cw-head-avatar" aria-hidden="true">
      <Icon name="robot" size={24} />
    </span>
    <span class="min-w-0 leading-tight">
      <span class="flex items-center gap-2">
        <span id="cw-title" class="text-[1rem] font-semibold text-white">IONIC</span>
        <span class="cw-badge"><Icon name="sparkle" size={11} /> IA</span>
      </span>
      <span class="mt-0.5 flex items-center gap-1.5 text-[0.78rem] text-white/70">
        <span class="cw-dot" aria-hidden="true"></span>
        Responde al instante
      </span>
    </span>
    <button
      type="button"
      class="ml-auto flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white/75 transition-colors hover:bg-white/15 hover:text-white"
      aria-label="Cerrar el chat"
      data-chat-close
    >
      <Icon name="close" size={18} />
    </button>
  </header>

  <p class="cw-disclaimer">
    Hablas con un asistente automático. Si prefieres una persona, escríbenos por WhatsApp.
  </p>

  <div class="cw-log" role="log" aria-live="polite" aria-label="Conversación con IONIC" data-chat-log>
    <div class="cw-row cw-row-model">
      <span class="cw-ava" aria-hidden="true"><Icon name="robot" size={17} /></span>
      <p class="cw-msg cw-model">{GREETING}</p>
    </div>
  </div>

  <!-- Atajos: quitan la hoja en blanco y llevan la conversación donde queremos. -->
  <div class="cw-chips" data-chat-chips>
    {sugerencias.map((texto) => <button type="button" class="cw-chip" data-chat-chip>{texto}</button>)}
  </div>

  <!-- Confirmación explícita antes de mover un dato personal: los valores los pone el servidor. -->
  <div class="cw-confirm" data-chat-confirm hidden>
    <p class="flex items-center gap-2 text-[0.85rem] font-semibold text-ink">
      <Icon name="shield" size={15} class="text-cobalt" />
      Revisa tus datos antes de enviarlos
    </p>
    <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-[0.85rem]">
      <dt class="text-ink-3">Negocio</dt>
      <dd class="min-w-0 truncate font-medium text-ink" data-cw-nombre></dd>
      <dt class="text-ink-3">Interés</dt>
      <dd class="min-w-0 truncate font-medium text-ink" data-cw-interes></dd>
      <dt class="text-ink-3">Teléfono</dt>
      <dd class="tnum min-w-0 truncate font-medium text-ink" data-cw-telefono></dd>
      <dt class="text-ink-3">Correo</dt>
      <dd class="min-w-0 truncate font-medium text-ink" data-cw-correo></dd>
    </dl>
    <div class="mt-3 flex flex-wrap gap-2">
      <button type="button" class="btn btn-primary !min-h-10 !px-4 text-[0.88rem]" data-chat-confirm-send>
        Confirmar y enviar
      </button>
      <button type="button" class="btn btn-ghost !min-h-10 !px-4 text-[0.88rem]" data-chat-confirm-edit>Corregir</button>
    </div>
    <p class="mt-2 text-[0.75rem] text-ink-3">
      Al enviar aceptas que te contactemos para coordinar el diagnóstico.
      <a href="/politica-de-privacidad" class="underline hover:text-ink-2">Cómo tratamos tus datos</a>.
    </p>
  </div>

  <p class="cw-hint" data-chat-hint hidden></p>

  <form class="cw-form" data-chat-form>
    <label class="sr-only" for="cw-input">Escribe tu mensaje para IONIC</label>
    <input
      id="cw-input"
      name="mensaje"
      type="text"
      maxlength="500"
      autocomplete="off"
      enterkeyhint="send"
      placeholder="Escribe tu mensaje…"
      class="cw-input"
      data-chat-input
    />
    <button type="submit" class="cw-send" aria-label="Enviar mensaje" data-chat-send>
      <Icon name="send" size={18} />
    </button>
  </form>

  <div class="cw-foot">
    <a href={waLink()} target="_blank" rel="noopener noreferrer" class="cw-foot-link">
      <Icon name="whatsapp" size={14} /> WhatsApp
    </a>
    <a href={CALENDAR_URL} target="_blank" rel="noopener noreferrer" class="cw-foot-link" data-chat-calendar>
      <Icon name="calendar" size={14} /> Elegir horario
    </a>
    <a href="/politica-de-privacidad" class="ml-auto hover:text-ink-2">Privacidad</a>
  </div>
</div>

<!-- Molde del avatar: el script lo clona en cada respuesta en vez de inyectar SVG desde JavaScript. -->
<template data-cw-ava-template>
  <span class="cw-ava" aria-hidden="true"><Icon name="robot" size={17} /></span>
</template>

<style>
  .cw-panel {
    position: fixed;
    z-index: 60;
    right: 1.25rem;
    bottom: 5.75rem;
    left: auto;
    width: min(23.5rem, calc(100vw - 2.5rem));
    max-height: min(33rem, calc(100dvh - 9rem));
    border-radius: 1.75rem;
    border: 1px solid var(--color-line);
    background: var(--color-canvas);
    box-shadow: var(--shadow-phone);
  }
  .cw-panel:not([hidden]) {
    display: flex;
    animation: cw-in 0.45s var(--ease-out-expo) both;
  }
  @keyframes cw-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
  }
  /*
   * Con el chat abierto el lanzador estorba: el panel ya tiene su botón de cerrar y así puede
   * apoyarse justo encima del flotante de WhatsApp. En móvil se aparta la columna entera.
   */
  :global(html.cw-open [data-chat-open]) {
    display: none;
  }
  @media (min-width: 640px) {
    .cw-panel {
      right: 1.5rem;
      bottom: 6.25rem;
      max-height: min(35rem, calc(100dvh - 10rem));
    }
  }
  /*
   * En móvil el panel va de debajo de la barra hasta abajo: se fijan `top` y `bottom` en vez de
   * calcular la altura, porque el minificador aplana los calc() que llevan var() dentro.
   */
  @media (max-width: 639px) {
    .cw-panel {
      right: 0.75rem;
      left: 0.75rem;
      top: 4.75rem;
      bottom: 0.75rem;
      width: auto;
      max-height: none;
    }
    :global(html.cw-open [data-float-stack]) {
      display: none;
    }
    /* Con el aviso de cookies abierto, el panel se apoya encima de él. */
    :global(html.cc-open) .cw-panel {
      bottom: var(--cc-lift, 0.75rem);
    }
  }

  /* ── Cabecera ─────────────────────────────────────────────────────────── */

  .cw-head {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    background: linear-gradient(135deg, var(--color-cobalt-glow), var(--color-cobalt) 45%, var(--color-cobalt-deep));
    color: #fff;
  }
  .cw-head-avatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }
  .cw-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.08rem 0.45rem 0.12rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.18);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cw-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: #34d399;
  }

  .cw-disclaimer {
    flex-shrink: 0;
    margin: 0;
    padding: 0.5rem 1rem;
    background: var(--color-ice);
    border-bottom: 1px solid var(--color-line-soft);
    color: var(--color-cobalt-ink);
    font-size: 0.76rem;
    line-height: 1.35;
  }

  /* ── Conversación ─────────────────────────────────────────────────────── */

  .cw-log {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1 1 auto;
    min-height: 7rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem 0.9rem;
    background:
      radial-gradient(120% 60% at 100% 0%, rgb(63 134 230 / 0.07), transparent 60%),
      var(--color-ice-3);
  }

  :global(.cw-row) {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    animation: msg-in 0.5s var(--ease-out-expo) both;
  }
  :global(.cw-row-user) {
    justify-content: flex-end;
  }
  :global(.cw-ava) {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 1.85rem;
    height: 1.85rem;
    margin-bottom: 0.1rem;
    border-radius: 999px;
    background: var(--color-canvas);
    color: var(--color-cobalt);
    box-shadow: 0 1px 3px rgb(8 58 122 / 0.14), inset 0 0 0 1px var(--color-ice-2);
  }
  /* En una ráfaga de respuestas seguidas sólo la primera lleva cara. */
  :global(.cw-ava-ghost) {
    visibility: hidden;
  }

  :global(.cw-msg) {
    position: relative;
    max-width: 78%;
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* Nubes: esquinas muy redondeadas y una punta hacia quien habla. */
  :global(.cw-model) {
    border-radius: 1.15rem 1.15rem 1.15rem 0.3rem;
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: 0 1px 2px rgb(15 23 34 / 0.06), inset 0 0 0 1px var(--color-line-soft);
  }
  :global(.cw-user) {
    border-radius: 1.15rem 1.15rem 0.3rem 1.15rem;
    background: linear-gradient(140deg, var(--color-cobalt), var(--color-cobalt-deep));
    color: #fff;
    box-shadow: 0 2px 8px -3px rgb(8 58 122 / 0.5);
  }
  :global(.cw-error) {
    max-width: 100%;
    border-radius: 1rem;
    background: var(--color-canvas);
    color: var(--color-ink-3);
    box-shadow: inset 0 0 0 1px var(--color-ice-2);
    font-size: 0.86rem;
    text-align: center;
  }
  :global(.cw-row-error) {
    justify-content: center;
  }

  :global(.cw-typing) {
    display: inline-flex;
    gap: 0.28rem;
    align-items: center;
    padding: 0.8rem 0.9rem;
  }
  :global(.cw-typing span) {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--color-cobalt-glow);
  }

  /* ── Atajos, confirmación y pie ───────────────────────────────────────── */

  /* `:not([hidden])` para que el atributo siga mandando: un `display` a secas lo anularía. */
  .cw-chips:not([hidden]) {
    display: flex;
  }
  .cw-chips {
    flex-shrink: 0;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0 0.9rem 0.75rem;
    background: var(--color-ice-3);
  }
  .cw-chip {
    border-radius: 999px;
    padding: 0.35rem 0.75rem;
    background: var(--color-canvas);
    box-shadow: inset 0 0 0 1px var(--color-ice-2);
    color: var(--color-cobalt-ink);
    font-size: 0.82rem;
    font-weight: 500;
    transition: background-color 0.25s, box-shadow 0.25s, transform 0.35s var(--ease-out-expo);
  }
  .cw-chip:hover {
    background: var(--color-ice);
    transform: translateY(-1px);
  }

  .cw-confirm {
    flex-shrink: 0;
    padding: 0.85rem 1rem;
    border-top: 1px solid var(--color-line-soft);
    background: var(--color-ice);
    animation: msg-in 0.5s var(--ease-out-expo) both;
  }

  .cw-hint {
    flex-shrink: 0;
    margin: 0;
    padding: 0.4rem 1rem;
    background: var(--color-ice-3);
    border-top: 1px solid var(--color-line-soft);
    color: var(--color-ink-3);
    font-size: 0.78rem;
    text-align: center;
  }

  .cw-form {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem;
    border-top: 1px solid var(--color-line-soft);
    background: var(--color-canvas);
  }
  .cw-input {
    min-width: 0;
    flex: 1 1 auto;
    border-radius: 999px;
    padding: 0.7rem 1rem;
    background: var(--color-ice-3);
    box-shadow: inset 0 0 0 1px var(--color-line);
    color: var(--color-ink);
    font-size: 0.96rem;
    transition: box-shadow 0.3s, background-color 0.3s;
  }
  .cw-input::placeholder {
    color: var(--color-ink-3);
    opacity: 0.75;
  }
  .cw-input:focus {
    outline: none;
    background: var(--color-canvas);
    box-shadow: inset 0 0 0 1.5px var(--color-cobalt), 0 0 0 4px rgb(14 95 203 / 0.14);
  }
  .cw-send {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: linear-gradient(140deg, var(--color-cobalt), var(--color-cobalt-deep));
    color: #fff;
    transition: transform 0.35s var(--ease-out-expo), opacity 0.25s;
  }
  .cw-send:hover:not(:disabled) {
    transform: scale(1.06);
  }
  .cw-send:disabled {
    opacity: 0.45;
  }

  .cw-foot {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    padding: 0.6rem 1rem;
    border-top: 1px solid var(--color-line-soft);
    background: var(--color-ice-3);
    color: var(--color-ink-3);
    font-size: 0.78rem;
  }
  .cw-foot-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--color-cobalt-ink);
  }
  .cw-foot-link:hover {
    color: var(--color-cobalt);
  }

  @media (prefers-reduced-motion: reduce) {
    .cw-panel:not([hidden]),
    :global(.cw-row),
    .cw-confirm {
      animation: none;
    }
  }
</style>

<script>
  import { FALLBACK_REPLY } from '../lib/chat/copy';

  const launcher = document.querySelector<HTMLButtonElement>('[data-chat-open]');
  const panel = document.querySelector<HTMLElement>('[data-chat-panel]');
  const log = document.querySelector<HTMLElement>('[data-chat-log]');
  const form = document.querySelector<HTMLFormElement>('[data-chat-form]');
  const input = document.querySelector<HTMLInputElement>('[data-chat-input]');
  const sendBtn = document.querySelector<HTMLButtonElement>('[data-chat-send]');
  const hint = document.querySelector<HTMLElement>('[data-chat-hint]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-chat-close]');
  const confirmBox = document.querySelector<HTMLElement>('[data-chat-confirm]');
  const confirmSend = document.querySelector<HTMLButtonElement>('[data-chat-confirm-send]');
  const confirmEdit = document.querySelector<HTMLButtonElement>('[data-chat-confirm-edit]');
  const chips = document.querySelector<HTMLElement>('[data-chat-chips]');
  const avaTemplate = document.querySelector<HTMLTemplateElement>('[data-cw-ava-template]');

  if (launcher && panel && log && form && input && sendBtn && hint && closeBtn && confirmBox && confirmSend && confirmEdit && chips && avaTemplate) {
    const STORE = 'ionoshub-chat';
    type Msg = { role: 'user' | 'model'; text: string };

    let token: string | null = null;
    let history: Msg[] = [];
    let busy = false;
    let closed = false;
    let restored = false;

    const gtag = (name: string, params: Record<string, unknown> = {}) =>
      (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.('event', name, params);

    const avatar = () => avaTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;

    /**
     * Pinta una fila. El texto va por textContent: nada de HTML venido del modelo.
     * Las respuestas seguidas comparten cara: sólo la primera del grupo la muestra.
     */
    const bubble = (text: string, kind: 'user' | 'model' | 'error') => {
      const row = document.createElement('div');
      row.className = `cw-row cw-row-${kind}`;
      if (kind === 'model') {
        const cara = avatar();
        const anterior = log.lastElementChild;
        if (anterior?.classList.contains('cw-row-model')) cara.classList.add('cw-ava-ghost');
        row.appendChild(cara);
      }
      const p = document.createElement('p');
      p.className = `cw-msg cw-${kind}`;
      p.textContent = text;
      row.appendChild(p);
      log.appendChild(row);
      log.scrollTop = log.scrollHeight;
      return row;
    };

    const typing = () => {
      const row = document.createElement('div');
      row.className = 'cw-row cw-row-model';
      row.setAttribute('aria-label', 'IONIC está escribiendo');
      row.appendChild(avatar());
      const bocadillo = document.createElement('div');
      bocadillo.className = 'cw-msg cw-model cw-typing';
      for (let i = 0; i < 3; i++) {
        const punto = document.createElement('span');
        punto.className = 'typing-dot';
        bocadillo.appendChild(punto);
      }
      row.appendChild(bocadillo);
      log.appendChild(row);
      log.scrollTop = log.scrollHeight;
      return row;
    };

    const setBusy = (value: boolean) => {
      busy = value;
      sendBtn.disabled = value || closed;
      input.disabled = closed;
    };

    const endChat = (message?: string) => {
      closed = true;
      if (message) bubble(message, 'error');
      confirmBox.hidden = true;
      chips.hidden = true;
      input.disabled = true;
      sendBtn.disabled = true;
      input.placeholder = 'Chat finalizado';
      save();
    };

    /** Muestra el resumen para que la persona confirme. Los valores vienen del servidor. */
    const showConfirm = (lead: Record<string, string>) => {
      const campos: [string, string][] = [
        ['[data-cw-nombre]', lead.nombre_negocio_o_persona],
        ['[data-cw-interes]', lead.servicio_interes],
        ['[data-cw-telefono]', lead.telefono],
        ['[data-cw-correo]', lead.correo],
      ];
      for (const [sel, value] of campos) {
        const el = confirmBox.querySelector(sel);
        if (el) el.textContent = value ?? '';
      }
      confirmBox.hidden = false;
      log.scrollTop = log.scrollHeight;
    };

    const sendLead = async () => {
      if (busy || closed) return;
      setBusy(true);
      confirmSend.disabled = true;
      try {
        const res = await fetch('/api/chat-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token, pagina_origen: location.href }),
        });
        const data = (await res.json()) as { reply?: string; token?: string; delivered?: boolean };
        if (!res.ok) {
          bubble('No pudimos enviar tus datos. Escríbenos por WhatsApp y lo resolvemos al instante.', 'error');
          confirmSend.disabled = false;
          return;
        }
        if (data.token) token = data.token;
        confirmBox.hidden = true;
        const reply = data.reply ?? 'Listo, un asesor se pondrá en contacto contigo.';
        bubble(reply, 'model');
        history = [...history, { role: 'model', text: reply }];
        // Conversión principal del sitio, igual que en el formulario.
        gtag('generate_lead', { method: 'chat', page_path: location.pathname });
        endChat();
      } catch {
        bubble('No pudimos enviar tus datos. Escríbenos por WhatsApp y lo resolvemos al instante.', 'error');
        confirmSend.disabled = false;
      } finally {
        setBusy(false);
      }
    };

    const save = () => {
      try {
        sessionStorage.setItem(STORE, JSON.stringify({ token, history, closed }));
      } catch {}
    };

    /** La conversación sobrevive a la navegación dentro del sitio, sólo en esta pestaña. */
    const restore = () => {
      if (restored) return;
      restored = true;
      try {
        const raw = sessionStorage.getItem(STORE);
        if (!raw) return;
        const data = JSON.parse(raw) as { token: string | null; history: Msg[]; closed: boolean };
        if (!Array.isArray(data.history) || !data.history.length) return;
        token = data.token ?? null;
        history = data.history;
        log.replaceChildren();
        chips.hidden = true;
        for (const m of history) bubble(m.text, m.role === 'user' ? 'user' : 'model');
        if (data.closed) endChat();
      } catch {}
    };

    const open = () => {
      restore();
      panel.hidden = false;
      launcher.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('cw-open');
      log.scrollTop = log.scrollHeight;
      if (!closed) input.focus({ preventScroll: true });
      gtag('chat_open', { page_path: location.pathname });
    };

    const close = () => {
      panel.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('cw-open');
      launcher.focus({ preventScroll: true });
    };

    const send = async (text: string) => {
      if (busy || closed) return;
      setBusy(true);
      chips.hidden = true;
      bubble(text, 'user');
      const dots = typing();
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, token, history }),
        });
        const data = (await res.json()) as {
          reply?: string;
          token?: string;
          remaining?: number;
          closed?: boolean;
          detail?: string;
          leadReady?: boolean;
          lead?: Record<string, string>;
        };
        dots.remove();

        if (!res.ok && !data.reply) {
          bubble(data.detail ?? FALLBACK_REPLY, 'error');
          if (res.status === 409) endChat('Se reinició la conversación. Vuelve a escribirnos cuando quieras.');
          return;
        }

        const reply = data.reply ?? FALLBACK_REPLY;
        bubble(reply, 'model');
        if (data.token) token = data.token;
        history = [...history, { role: 'user', text }, { role: 'model', text: reply }];
        gtag('chat_message', { page_path: location.pathname });

        if (data.leadReady && data.lead) showConfirm(data.lead);
        else confirmBox.hidden = true;

        if (typeof data.remaining === 'number' && data.remaining > 0 && data.remaining <= 3) {
          hint.hidden = false;
          hint.textContent =
            data.remaining === 1 ? 'Queda 1 mensaje en este chat.' : `Quedan ${data.remaining} mensajes en este chat.`;
        } else {
          hint.hidden = true;
        }
        if (data.closed) endChat();
        else save();
      } catch {
        dots.remove();
        bubble(FALLBACK_REPLY, 'error');
      } finally {
        setBusy(false);
        if (!closed) input.focus({ preventScroll: true });
      }
    };

    launcher.addEventListener('click', () => (panel.hidden ? open() : close()));
    closeBtn.addEventListener('click', close);
    confirmSend.addEventListener('click', () => void sendLead());
    confirmEdit.addEventListener('click', () => {
      confirmBox.hidden = true;
      input.focus({ preventScroll: true });
    });
    chips.querySelectorAll<HTMLButtonElement>('[data-chat-chip]').forEach((chip) =>
      chip.addEventListener('click', () => void send(chip.textContent!.trim())),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close();
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      void send(text);
    });
  }
</script>
