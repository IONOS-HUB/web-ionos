---
/**
 * Tarjeta de una edición en el índice. El cartel va de banner; debajo, fecha, título, cuenta
 * atrás y el enlace al formulario de registro.
 *
 * Si al compilar la edición aún es futura, la tarjeta lleva también su versión de "ya emitido"
 * (oculta) y `src/scripts/webinar-vigencia.ts` cambia de una a otra en el navegador cuando llega la
 * hora, aunque no haya habido un despliegue desde entonces.
 */
import Icon from '../Icon.astro';
import WebinarCountdown from './WebinarCountdown.astro';
import { formatWebinarShort, formatWebinarTime, isUpcoming, type Webinar } from '../../data/webinars';

interface Props {
  webinar: Webinar;
}
const { webinar } = Astro.props;
const proximo = isUpcoming(webinar);
const fecha = formatWebinarShort(webinar.startsAt);
const hora = formatWebinarTime(webinar.startsAt);
const hrefPasado = `/webinars/${webinar.slug}`;
const href = proximo ? `${hrefPasado}#registro` : hrefPasado;
const cartel = webinar.promoImage;
---

<article
  class="wcard group flex h-full min-w-0 flex-col overflow-hidden rounded-3xl border border-line bg-canvas shadow-lift"
  data-webinar-card
  data-vigencia
  data-starts-at={webinar.startsAt}
  data-status={proximo ? 'proximo' : 'pasado'}
  data-topics={webinar.topics.join('|')}
>
  {
    cartel && (
      <div class="relative h-50 overflow-hidden bg-ice-3 sm:h-60">
        <img
          src={cartel.src}
          alt={cartel.alt}
          width={cartel.width}
          height={cartel.height}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.02]"
        />
      </div>
    )
  }

  {
    proximo && (
      <header class="flex items-center gap-3 bg-cobalt px-5 py-3.5 text-white" data-solo="proximo">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
          <Icon name="calendar" size={17} />
        </span>
        <span class="min-w-0 leading-tight">
          <span class="tnum block text-[0.95rem] font-semibold">{fecha}</span>
          <span class="tnum block text-[0.78rem] text-white/70">{hora} · {webinar.timezone}</span>
        </span>
        <span class="ml-auto shrink-0 rounded-full bg-white px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-cobalt-ink">
          Registro abierto
        </span>
      </header>
    )
  }
  <header class="flex items-center gap-3 bg-night px-5 py-3.5 text-white" data-solo="pasado" hidden={proximo}>
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
      <Icon name="calendar" size={17} />
    </span>
    <span class="min-w-0 leading-tight">
      <span class="tnum block text-[0.95rem] font-semibold">{fecha}</span>
      <span class="tnum block text-[0.78rem] text-white/70">Edición {webinar.edition}</span>
    </span>
    <span class="ml-auto shrink-0 rounded-full bg-night-2 px-2.5 py-1 text-[0.7rem] font-semibold uppercase tracking-wide text-night-text">
      Ya emitido
    </span>
  </header>

  <div class="flex flex-1 flex-col p-5">
    <h3 class="display-tight text-[1.35rem] font-semibold leading-tight text-ink">
      <a href={href} data-href-pasado={proximo ? hrefPasado : undefined} class="after:absolute after:inset-0 hover:text-cobalt-ink">{webinar.title}</a>
    </h3>
    {
      !cartel && (
        <p class="mt-2.5 line-clamp-3 text-[0.98rem] leading-relaxed text-ink-2">{webinar.summary}</p>
      )
    }

    {
      proximo && (
        <div class="mt-4" data-solo="proximo">
          <WebinarCountdown startsAt={webinar.startsAt} tone="light" compact class="justify-start" />
        </div>
      )
    }

    <ul class="mt-4 flex flex-wrap gap-1.5">
      {webinar.topics.map((t) => <li class="chip text-[0.8rem]">{t}</li>)}
    </ul>

    <p class="mt-5 flex items-center gap-2 text-[0.88rem] font-semibold text-cobalt-ink">
      {proximo && <span data-solo="proximo">Reservar mi lugar</span>}
      <span data-solo="pasado" hidden={proximo}>Ver qué se trató</span>
      <Icon name="arrow-right" size={15} class="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1" />
    </p>
  </div>

  <footer class="flex items-center gap-2 border-t border-line-soft bg-ice-3 px-5 py-3 text-[0.8rem] text-ink-3">
    {webinar.hosts.join(' × ')}
  </footer>
</article>

<style>
  .wcard {
    position: relative;
    transition: transform 0.6s var(--ease-out-expo), box-shadow 0.6s var(--ease-out-expo);
  }
  @media (hover: hover) {
    .wcard:hover {
      transform: translateY(-4px);
    }
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }
</style>

<script>
  import '../../scripts/webinar-vigencia';
</script>
