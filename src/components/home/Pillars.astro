---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import PillarDemo from '../demos/PillarDemo.astro';
import { pillars } from '../../data/pillars';
import { getCaseBySlug } from '../../data/cases';
---

<section id="ecosistema" class="scroll-mt-24 bg-ice-3 py-20 lg:py-28">
  <div class="wrap">
    <SectionHeading
      title="Cuatro pilares. Un solo ecosistema."
      lead="Empieza por el que más te duela hoy. Cada pilar funciona solo y se vuelve más potente cuando se conecta con los demás."
    />

    <div class="mt-10 flex flex-col divide-y divide-line lg:mt-14">
      {
        pillars.map((p, i) => {
          const relatedCase = p.caseSlugs[0] ? getCaseBySlug(p.caseSlugs[0]) : undefined;
          const flip = i % 2 === 1;
          return (
            <article class="grid gap-8 py-12 lg:grid-cols-12 lg:items-center lg:gap-12 lg:py-16" data-reveal>
              <div class:list={['lg:col-span-6', flip && 'lg:order-2']}>
                <h3 class="display-tight flex items-center gap-3 text-[clamp(1.75rem,3vw,2.5rem)] font-semibold text-ink">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-cobalt text-white"><Icon name={p.id} size={22} /></span>
                  {p.title}
                </h3>
                <p class="mt-3 text-[1.15rem] leading-relaxed text-cobalt-ink">{p.tagline}</p>
                <p class="mt-4 text-[1.02rem] leading-relaxed text-ink-2">{p.problem}</p>
                <ul class="mt-6 flex flex-col gap-2.5">
                  {p.includes.slice(0, 5).map((item) => (
                    <li class="flex items-start gap-3 text-[1rem] text-ink">
                      <Icon name="check" size={18} class="mt-1 shrink-0 text-cobalt" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-7 flex flex-wrap items-center gap-4">
                  <a href={p.route} class="btn btn-ghost !min-h-11">
                    Ver {p.short === 'IA' ? 'inteligencia artificial' : p.short.toLowerCase()}
                    <Icon name="arrow-right" size={18} />
                  </a>
                  {relatedCase && (
                    <a href="/casos-de-exito" class="inline-flex items-center gap-2 text-[0.95rem] font-semibold text-cobalt-ink hover:text-cobalt">
                      Caso {relatedCase.client}: {relatedCase.highlight}
                      <Icon name="arrow-up-right" size={16} />
                    </a>
                  )}
                </div>
              </div>

              <div class:list={['lg:col-span-6', flip && 'lg:order-1']}>
                <PillarDemo pillar={p.id} />
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
