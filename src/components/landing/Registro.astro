---
/**
 * Página de registro "speed to lead": la misma estructura para las tres variantes; lo que cambia vive en
 * `src/data/landings.ts` (y, en las de nicho, en `niches.ts`).
 *
 * 1. Barra con la marca (sin enlaces: tráfico de pauta) y un atajo al formulario.
 * 2. Portada: titular y promesas sobre blanco, el formulario flotando sobre el campo de color (cobalto en
 *    la general, noche con video en los nichos). En móvil, el campo es una banda a sangre tras el titular.
 *    Bajo las credenciales, la prueba más cercana al formulario: un caso con cifra y logos de clientes.
 *    Si hay un testimonio en video (`testimonials.ts`), va en una banda justo después de la portada.
 * 3. Qué pasa después de enviar: los cuatro pasos reales, que se encienden en secuencia.
 * 4. El ecosistema (general: pilares + flujo hacia el CRM), la demostración del sector (nicho) o cómo se
 *    construye, con capturas reales (variantes de servicio, `process`).
 * 5. Prueba en noche: casos reales con cifra, cliente del sector y logos.
 * 6. Quién atiende: los cofundadores y el equipo.
 * 7. Cierre en cobalto y pie legal mínimo.
 *
 * Todo lo que se muestra es real o va etiquetado como demostración (PRODUCT.md): nada se inventa para
 * rellenar. Los contenedores decorativos usan `overflow-clip`, no `overflow-hidden`: un `hidden` sigue
 * siendo desplazable por el navegador y, al enfocar un campo, corría la portada de lado en móvil.
 */
import Icon from '../Icon.astro';
import BrandMark from '../BrandMark.astro';
import ClientLogo from '../ClientLogo.astro';
import FlowDemo from '../demos/FlowDemo.astro';
import NicheDemo from '../demos/NicheDemo.astro';
import MediaGallery from '../MediaGallery.astro';
import MotionBackdrop from './MotionBackdrop.astro';
import FormWindow from './FormWindow.astro';
import { team } from '../../data/team';
import { successCases } from '../../data/cases';
import { clients, partners } from '../../data/site-content';
import { pillars } from '../../data/pillars';
import { testimonials } from '../../data/testimonials';
import { systemsGallery } from '../../data/photos';
import { waLink } from '../../lib/site';
import type { LandingVariant } from '../../data/landings';
import type { Niche } from '../../data/niches';

interface Props {
  landing: LandingVariant;
  niche?: Niche;
}
const { landing, niche } = Astro.props;

const founders = team.filter((m) => m.area === 'Dirección');
const resto = team.filter((m) => m.area !== 'Dirección');

// El caso del sector (o de la variante) va primero si existe; se completa hasta tres con los casos con cifra más claros.
const slugs = [...new Set([niche?.proof.caseSlug ?? landing.caseSlug, 'zona-gamers', 'daniela-vidal', 'pawau'].filter(Boolean))].slice(0, 3);
const casos = slugs
  .map((slug) => successCases.find((c) => c.slug === slug))
  .filter((c): c is (typeof successCases)[number] => Boolean(c));
const loop = [...clients, ...clients];

// Junto al formulario: el caso principal y seis logos, con el del caso primero.
const destacado = casos[0];
const logosCerca = [...clients].sort((a, b) => Number(b.src === destacado?.logo) - Number(a.src === destacado?.logo)).slice(0, 6);

// Testimonios: el primero con video sale tras la portada; los de texto, en la banda de casos (sólo la general).
const conVideo = testimonials.find((t) => t.video);
const deTexto = testimonials.filter((t) => !t.video);

// Variantes de servicio: cuatro capturas reales, con la del caso de la variante primero.
const capturas = landing.process
  ? {
      ...systemsGallery,
      items: [...systemsGallery.items].sort((a, b) => Number(b.label === destacado?.client) - Number(a.label === destacado?.client)).slice(0, 4),
    }
  : undefined;
const anio = new Date().getFullYear();
---

<!-- 1 · Marca -->
<header class="sticky top-0 z-30 border-b border-line-soft bg-canvas/90 backdrop-blur-md">
  <div class="wrap flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
    <img src="/imgs/logo.webp" alt="IonosHub" width="463" height="140" class="h-9 w-auto lg:h-10" decoding="async" fetchpriority="high" />
    <div class="flex items-center gap-5">
      <p class="hidden items-center gap-2 text-[0.92rem] text-ink-2 md:flex">
        <Icon name="clock" size={16} class="text-cobalt" />
        Te contactamos en menos de un día hábil
      </p>
      <a href="#formulario" class="btn btn-primary !min-h-11 !px-5 text-[0.95rem]" data-stl-goto>
        {niche ? 'Pedir demostración' : 'Agendar'}
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</header>

<!-- 2 · Portada -->
<section class="relative overflow-clip">
  <!--
    Tres bloques en la retícula: titular, formulario y confianza. Móvil: en ese orden (el formulario justo
    tras el titular). Escritorio: titular y confianza apilados a la izquierda, formulario a la derecha.
  -->
  <div
    class="wrap grid grid-cols-[minmax(0,1fr)] gap-10 pt-9 lg:min-h-[calc(100dvh-4.5rem)] lg:grid-cols-12 lg:grid-rows-[auto_auto] lg:content-center lg:gap-x-8 lg:gap-y-0 lg:py-14"
  >
    <div class="min-w-0 lg:col-span-6 lg:row-start-1 lg:self-end lg:pr-4">
      <h1 class="hero-in display-tight text-[clamp(2.3rem,4.2vw,3.6rem)] font-semibold text-ink">
        {landing.h1}
        <span class="block text-cobalt">{landing.h1Accent}</span>
      </h1>
      <p class="hero-in mt-5 max-w-xl text-[clamp(1.05rem,1.4vw,1.22rem)] leading-relaxed text-ink-2" style="--d: 80ms">
        {landing.lead}
      </p>
    </div>

    <!--
      El campo de color es un solo elemento: en móvil cubre esta columna (banda a sangre); en escritorio la
      columna deja de ser posicionada y el campo se ancla a la sección, a la derecha. Así hay un solo video.
    -->
    <div
      class="relative isolate min-w-0 py-10 max-lg:mx-[calc(-1*clamp(1.25rem,4vw,2.5rem))] max-lg:px-[clamp(1.25rem,4vw,2.5rem)] lg:static lg:col-span-5 lg:col-start-8 lg:row-span-2 lg:row-start-1 lg:self-center lg:py-0"
    >
      <div class="absolute inset-0 -z-10 overflow-clip rounded-t-[2.25rem] lg:inset-y-0 lg:left-auto lg:right-0 lg:w-[44%] lg:rounded-none lg:rounded-l-[4rem]">
        <MotionBackdrop background={niche ? landing.background : undefined} tone={niche ? 'night' : 'cobalt'} />
      </div>

      <div class="hero-in relative z-10" style="--d: 140ms">
        <FormWindow landing={landing} />
      </div>
    </div>

    <!-- En móvil la prueba (caso + logos) sube a ser lo primero bajo el formulario; en escritorio cierra la columna. -->
    <div class="flex min-w-0 flex-col pb-12 lg:col-span-6 lg:row-start-2 lg:self-start lg:pb-0 lg:pr-4">
      <ul class="flex flex-col gap-3 lg:mt-7">
        {
          landing.promises.map((p, i) => (
            <li class="hero-in flex items-start gap-3 text-[1.02rem] text-ink" style={`--d: ${160 + i * 70}ms`}>
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cobalt text-white">
                <Icon name="check" size={15} />
              </span>
              <span class="pt-0.5">{p}</span>
            </li>
          ))
        }
      </ul>

      <div class="hero-in mt-9 flex items-center gap-4 border-t border-line-soft pt-6" style="--d: 380ms">
        <ul class="flex shrink-0 -space-x-3" aria-hidden="true">
          {
            founders.map((m) => (
              <li>
                <img src={m.photo} alt="" width="52" height="52" decoding="async" class="h-[3.25rem] w-[3.25rem] rounded-full border-[3px] border-canvas object-cover object-top" />
              </li>
            ))
          }
        </ul>
        <p class="text-[0.95rem] leading-snug text-ink-2">
          <span class="font-semibold text-ink">{founders.map((m) => m.name.split(' ')[0]).join(' y ')}</span>, cofundadores de IonosHub, revisan
          cada solicitud.
        </p>
      </div>

      <ul class="hero-in mt-5 flex flex-wrap gap-2" aria-label="Partners y credenciales" style="--d: 440ms">
        {
          partners.map((p, i) => (
            <li
              class:list={[
                'inline-flex items-center gap-2 rounded-full px-3 py-1.5 text-[0.82rem] font-semibold',
                i === 0 ? 'bg-cobalt text-white' : 'border border-cobalt/30 bg-ice text-cobalt-ink',
              ]}
            >
              <BrandMark name={p.brand} size={14} />
              {p.name} · {p.credential}
            </li>
          ))
        }
      </ul>

      <div class="hero-in rounded-[1.25rem] border border-line bg-ice-3 p-5 max-lg:order-first max-lg:mb-8 lg:mt-7" style="--d: 500ms">
        {
          destacado && (
            <p class="leading-snug">
              <span class="tnum block text-[1.4rem] font-semibold text-cobalt-ink">{destacado.highlight.replace(/(\d) %/g, '$1\u00a0%')}</span>
              <span class="mt-1 block text-[0.92rem] text-ink-2">
                <span class="font-semibold text-ink">{destacado.client}</span> · {destacado.result}
              </span>
            </p>
          )
        }
        <p class="mt-4 text-[0.72rem] font-semibold uppercase tracking-wide text-ink-3">Negocios que ya trabajan con nosotros</p>
        <ul class="mt-2.5 grid grid-cols-3 gap-2 sm:grid-cols-6" aria-label="Clientes de IonosHub">
          {
            logosCerca.map((c) => (
              <li>
                <ClientLogo src={c.src} alt={c.alt} size="sm" class="!w-full" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>

  </div>
</section>

{
  conVideo?.video && (
    <section class="pb-16 lg:py-20" aria-label={`Testimonio de ${conVideo.name}`}>
      <div class="wrap grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class:list={['min-w-0 lg:order-2', conVideo.video.vertical ? 'lg:col-span-5 lg:col-start-8' : 'lg:col-span-7']} data-reveal>
          <div class:list={['overflow-clip rounded-[1.5rem] border border-line bg-night shadow-lift', conVideo.video.vertical && 'mx-auto max-w-[22rem]']}>
            <video
              controls
              playsinline
              preload="none"
              poster={conVideo.video.poster}
              class:list={['block w-full bg-night object-cover', conVideo.video.vertical ? 'aspect-[9/16]' : 'aspect-video']}
            >
              {conVideo.video.webm && <source src={conVideo.video.webm} type="video/webm" />}
              <source src={conVideo.video.mp4} type="video/mp4" />
            </video>
          </div>
        </div>
        <div class="min-w-0 lg:order-1 lg:col-span-5">
          <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink" data-reveal>Lo cuenta {conVideo.name.split(' ')[0]}.</h2>
          <blockquote class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2" data-reveal data-reveal-delay="60">“{conVideo.quote}”</blockquote>
          <div class="mt-6 flex items-center gap-4" data-reveal data-reveal-delay="120">
            {conVideo.logo && <ClientLogo src={conVideo.logo} alt={conVideo.company} size="sm" />}
            <p class="text-[0.92rem] leading-tight text-ink-2">
              <span class="block font-semibold text-ink">{conVideo.name}</span>
              {conVideo.role} · {conVideo.company}
            </p>
          </div>
          <a href="#formulario" class="btn btn-primary mt-8 max-sm:w-full" data-stl-goto data-reveal data-reveal-delay="160">
            {landing.form.cta}
            <Icon name="arrow-right" size={18} />
          </a>
        </div>
      </div>
    </section>
  )
}

<!-- 3 · Qué pasa después de enviar -->
<section class="bg-ice-3 py-20 lg:py-28">
  <div class="wrap">
    <div class="max-w-3xl">
      <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink" data-reveal>Así de rápido responde un ecosistema bien armado.</h2>
      <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2" data-reveal data-reveal-delay="60">
        Esta página funciona como lo que construimos para nuestros clientes: el lead entra, se registra solo y una persona responde
        antes de que se enfríe.
      </p>
    </div>

    <ol class="tl mt-12 grid gap-8 lg:mt-16 lg:grid-cols-4 lg:gap-6" data-reveal data-reveal-delay="120">
      {
        landing.steps.map((s, i) => (
          <li class="tl-step relative grid grid-cols-[2.75rem_1fr] gap-4 lg:grid-cols-1" style={`--d: ${i * 0.55}s`}>
            {/* Conector hasta el disco siguiente: hacia abajo en móvil (salva el gap de 2 rem), a la derecha en escritorio (1.5 rem). */}
            {i < landing.steps.length - 1 && (
              <span
                class="tl-link absolute left-[1.3125rem] top-11 -bottom-8 w-0.5 bg-ice-2 lg:bottom-auto lg:left-11 lg:top-[1.3125rem] lg:h-0.5 lg:w-[calc(100%-1.25rem)]"
                aria-hidden="true"
              >
                <span class="tl-fill absolute inset-0 bg-cobalt" />
              </span>
            )}
            <span class="tl-dot tnum relative z-10 flex h-11 w-11 items-center justify-center rounded-full bg-cobalt text-[1rem] font-semibold text-white shadow-lift">
              {i + 1}
            </span>
            <div>
              <p class="text-[0.72rem] font-semibold uppercase tracking-wide text-cobalt-ink">{s.when}</p>
              <h3 class="mt-1.5 text-[1.25rem] font-semibold leading-snug text-ink">{s.title}</h3>
              <p class="mt-1.5 text-[0.98rem] leading-relaxed text-ink-2">{s.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- 4 · El ecosistema (general), la demostración del sector (nicho) o cómo se construye (servicio) -->
{
  landing.process && capturas ? (
    <section class="py-20 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="min-w-0 lg:col-span-5">
          <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink" data-reveal>
            {landing.process.title}
          </h2>
          <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2" data-reveal data-reveal-delay="60">
            {landing.process.lead}
          </p>
          <ol class="mt-8 divide-y divide-line border-y border-line" data-reveal data-reveal-delay="120">
            {landing.process.steps.map((p, i) => (
              <li class="flex items-start gap-4 py-4">
                <span class="tnum flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-cobalt text-[0.95rem] font-semibold text-white">{i + 1}</span>
                <div>
                  <p class="text-[1.05rem] font-semibold text-ink">{p.title}</p>
                  <p class="mt-0.5 text-[0.92rem] leading-snug text-ink-2">{p.detail}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="mt-6 text-[0.98rem] font-semibold text-cobalt-ink" data-reveal data-reveal-delay="160">
            {landing.process.forWhom}
          </p>
        </div>
        <div class="min-w-0 lg:col-span-7" data-reveal data-reveal-delay="100">
          <MediaGallery gallery={capturas} variant="screen" />
        </div>
      </div>
    </section>
  ) : niche ? (
    <section class="py-20 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="min-w-0 lg:col-span-6" data-reveal>
          <NicheDemo niche={niche} />
        </div>
        <div class="min-w-0 lg:col-span-6">
          <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink" data-reveal>
            {niche.id === 'clinicas' ? 'Así sonaría en tu consultorio.' : 'Así respondería en tu institución.'}
          </h2>
          <ul class="mt-8 flex flex-col gap-3.5" data-reveal data-reveal-delay="60">
            {niche.jobs.slice(0, 4).map((j) => (
              <li class="flex items-start gap-3 text-[1rem] leading-relaxed text-ink-2">
                <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cobalt text-white">
                  <Icon name="check" size={15} />
                </span>
                {j}
              </li>
            ))}
          </ul>
          <div class="mt-8 rounded-[1.25rem] border border-line bg-ice-3 p-5 sm:p-6" data-reveal data-reveal-delay="120">
            <p class="text-[0.72rem] font-semibold uppercase tracking-wide text-ink-3">Lo que nunca hace</p>
            <ul class="mt-3 flex flex-col gap-2.5">
              {niche.redLines.map((r) => (
                <li class="flex items-start gap-3 text-[0.98rem] leading-snug text-ink">
                  <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-canvas text-cobalt-ink ring-1 ring-line">
                    <Icon name="shield" size={13} />
                  </span>
                  {r}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="py-20 lg:py-28">
      <div class="wrap grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
        <div class="min-w-0 lg:col-span-5">
          <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink" data-reveal>
            Un solo equipo para todo tu ecosistema.
          </h2>
          <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2" data-reveal data-reveal-delay="60">
            Puedes empezar por una pieza. Lo que construimos se conecta con lo siguiente, para que ningún lead dependa de que alguien lo
            vea a tiempo.
          </p>
          <ul class="mt-8 divide-y divide-line border-y border-line" data-reveal data-reveal-delay="120">
            {pillars.map((p) => (
              <li class="pillar-row flex items-start gap-4 py-4">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ice text-cobalt-ink transition-colors duration-300">
                  <Icon name={p.id} size={19} />
                </span>
                <div>
                  <p class="text-[1.05rem] font-semibold text-ink">{p.title}</p>
                  <p class="mt-0.5 text-[0.92rem] leading-snug text-ink-2">{p.tagline}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="min-w-0 lg:col-span-7" data-reveal data-reveal-delay="100">
          <FlowDemo />
        </div>
      </div>
    </section>
  )
}

<!-- 5 · Prueba -->
<section class="relative overflow-clip bg-night py-20 text-white lg:py-28">
  <div class="pointer-events-none absolute -right-40 top-0 h-[30rem] w-[30rem] rounded-full bg-cobalt/30 blur-3xl" aria-hidden="true"></div>
  <div class="wrap relative">
    <div class="max-w-3xl">
      <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold" data-reveal>Resultados reales, con nombre y apellido.</h2>
      <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-night-text" data-reveal data-reveal-delay="60">
        Negocios de Ecuador que ya trabajan con su ecosistema. Las cifras son las suyas.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-3 lg:mt-14" aria-label="Casos reales">
      {
        casos.map((c, i) => (
          <li class="case-card flex flex-col rounded-[1.5rem] border border-night-line bg-night-2 p-6 sm:p-7" data-reveal data-reveal-delay={String(100 + i * 90)}>
            {c.logo && <ClientLogo src={c.logo} alt={c.client} size="md" class="!border-transparent" />}
            <p class="tnum mt-6 text-[clamp(1.7rem,2.6vw,2.2rem)] font-semibold leading-tight">{c.highlight.replace(/(\d) %/g, '$1\u00a0%')}</p>
            <p class="mt-3 text-[0.98rem] leading-relaxed text-night-text">{c.result}</p>
            <p class="mt-auto pt-6 text-[0.85rem] font-semibold text-white">
              {c.client}
              <span class="font-normal text-night-text"> · {c.industry}</span>
            </p>
          </li>
        ))
      }
    </ul>

    {
      niche?.proof.clientLogo && !niche.proof.caseSlug && (
        <div class="mt-5 flex flex-col gap-4 rounded-[1.5rem] border border-night-line p-6 sm:flex-row sm:items-center sm:gap-6" data-reveal>
          <ClientLogo src={niche.proof.clientLogo} alt={niche.proof.clientName ?? ''} size="lg" class="!border-transparent" />
          <p class="text-[1.05rem] leading-snug text-night-text">
            En tu sector ya trabajamos con <span class="font-semibold text-white">{niche.proof.clientName}</span>.
          </p>
        </div>
      )
    }

    {
      deTexto.length > 0 && !niche && (
        <ul class="mt-5 grid gap-5 md:grid-cols-2" aria-label="Testimonios">
          {deTexto.slice(0, 2).map((t) => (
            <li class="rounded-[1.5rem] border border-night-line p-6 sm:p-7" data-reveal>
              <blockquote class="text-[1.05rem] leading-relaxed text-white">“{t.quote}”</blockquote>
              <div class="mt-4 flex items-center gap-3">
                {t.photo && <img src={t.photo} alt="" width="40" height="40" loading="lazy" decoding="async" class="h-10 w-10 rounded-full object-cover" />}
                <p class="text-[0.85rem] leading-tight text-night-text">
                  <span class="block font-semibold text-white">{t.name}</span>
                  {t.role} · {t.company}
                </p>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="marquee relative mt-14 overflow-clip [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]" aria-label="Clientes de IonosHub">
    <ul class="marquee-track flex w-max items-center gap-4 pr-4">
      {
        loop.map((c, i) => (
          <li class="shrink-0" aria-hidden={i >= clients.length ? 'true' : undefined}>
            <ClientLogo src={c.src} alt={i >= clients.length ? '' : c.alt} size="md" class="!border-transparent" />
          </li>
        ))
      }
