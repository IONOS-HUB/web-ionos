<style>
  /*
   * Línea de tiempo: el estado por defecto es el final (riel lleno, discos cobalto). Sólo con motion y
   * antes de entrar en pantalla se vacía; al entrar (`.is-in`, del reveal) el riel se llena y cada disco
   * se enciende a su tiempo (`--d`). Longhands: el minificador vacía el atajo `animation` con var().
   */
  :global(html.motion-ready) .tl .tl-fill {
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 0.55s var(--ease-out-quint);
  }
  :global(html.motion-ready) .tl.is-in .tl-fill {
    transform: none;
    transition-delay: calc(var(--d) + 0.25s);
  }
  :global(html.motion-ready) .tl:not(.is-in) .tl-dot {
    background: var(--color-ice-2);
    color: var(--color-ink-3);
    box-shadow: none;
  }
  :global(html.motion-ready) .tl.is-in .tl-dot {
    animation-name: tl-on;
    animation-duration: 0.6s;
    animation-timing-function: var(--ease-out-expo);
    animation-fill-mode: both;
    animation-delay: var(--d);
  }
  :global(html.motion-ready) .tl:not(.is-in) .tl-step > div {
    opacity: 0.35;
  }
  :global(html.motion-ready) .tl.is-in .tl-step > div {
    transition: opacity 0.6s var(--ease-out-expo);
    transition-delay: var(--d);
  }
  @keyframes tl-on {
    from {
      background: var(--color-ice-2);
      color: var(--color-ink-3);
      transform: scale(0.85);
    }
    60% {
      transform: scale(1.12);
    }
  }
  @media (min-width: 1024px) {
    :global(html.motion-ready) .tl .tl-fill {
      transform-origin: left;
      transform: scaleX(0);
    }
  }

  /* Filas de pilar: el disco se enciende al pasar. */
  .pillar-row:hover > span {
    background: var(--color-cobalt);
    color: #fff;
  }

  /* Casos: suben un poco al pasar. */
  .case-card {
    transition:
      transform 0.5s var(--ease-out-expo),
      border-color 0.3s;
  }
  .case-card:hover {
    transform: translateY(-4px);
    border-color: rgb(63 134 230 / 0.6);
  }

  /* Fotos del equipo: escala de grises que recupera el color al pasar (DESIGN.md). */
  .founder-photo {
    filter: grayscale(1) contrast(1.05);
    transition:
      filter 0.6s var(--ease-out-expo),
      transform 0.8s var(--ease-out-expo);
  }
  .founder:hover .founder-photo {
    filter: none;
    transform: scale(1.03);
  }

  /* En móvil, con el teclado abierto, los flotantes (chat y WhatsApp) no tapan el campo que se escribe. */
  @media (max-width: 1023px) {
    :global(body:has(#formulario :focus) [data-float-stack]) {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>

<script>
  // Los atajos "Agendar" llevan al formulario y dejan el cursor en el primer campo, sin un segundo toque.
  document.querySelectorAll<HTMLAnchorElement>('[data-stl-goto]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const destino = document.getElementById('formulario');
      if (!destino) return;
      e.preventDefault();
      const suave = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      destino.scrollIntoView({ behavior: suave ? 'smooth' : 'auto', block: 'start' });
      window.setTimeout(() => document.getElementById('stl-nombre')?.focus({ preventScroll: true }), suave ? 550 : 0);
    }),
  );
</script>
