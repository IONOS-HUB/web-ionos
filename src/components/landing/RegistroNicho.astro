---
/**
 * Página de registro de un nicho (instituciones, clínicas): una sola pantalla, el formulario sobre el
 * fondo motion o el video del sector. Sin testimonios. El acabado lo dan el fondo, el velo, un halo
 * cobalto detrás de la ventanilla y el cliente real del sector (`niche.proof`), si existe.
 */
import Icon from '../Icon.astro';
import ClientLogo from '../ClientLogo.astro';
import MotionBackdrop from './MotionBackdrop.astro';
import FormWindow from './FormWindow.astro';
import type { LandingVariant } from '../../data/landings';
import type { Niche } from '../../data/niches';

interface Props {
  landing: LandingVariant;
  niche: Niche;
}
const { landing, niche } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-night text-white">
  <MotionBackdrop background={landing.background} />

  <!-- Móvil: titular → formulario → promesas. Escritorio: texto a la izquierda, formulario a la derecha. -->
  <div class="wrap relative grid gap-8 py-12 lg:min-h-[calc(100dvh-4.5rem)] lg:grid-cols-12 lg:grid-rows-[1fr_auto_auto_1fr] lg:gap-x-14 lg:gap-y-0 lg:py-16">
    <div class="min-w-0 lg:col-span-7 lg:row-start-2">
      <h1 class="display-tight text-[clamp(2.1rem,3.8vw,3.3rem)] font-semibold" data-reveal>
        {landing.h1}
        <span class="block text-night-text">{landing.h1Accent}</span>
      </h1>
      <p class="mt-5 max-w-2xl text-[clamp(1.02rem,1.4vw,1.2rem)] leading-relaxed text-white/85" data-reveal data-reveal-delay="60">
        {landing.lead}
      </p>
    </div>

    <div class="relative min-w-0 lg:col-span-5 lg:col-start-8 lg:row-span-4 lg:row-start-1 lg:self-center" data-reveal data-reveal-delay="100">
      <!-- Halo detrás de la ventanilla: la despega del video sin sombra dura. -->
      <div class="pointer-events-none absolute -inset-6 -z-10 rounded-[2.5rem] bg-cobalt-glow/25 blur-3xl" aria-hidden="true"></div>
      <FormWindow landing={landing} class="ring-1 ring-white/10" />
    </div>

    <div class="min-w-0 lg:col-span-7 lg:row-start-3">
      <ul class="flex flex-col gap-3 lg:mt-8" data-reveal data-reveal-delay="120">
        {
          landing.promises.map((p) => (
            <li class="flex items-start gap-3 text-[1.02rem] text-white">
              <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/20 bg-white/10">
                <Icon name="check" size={15} />
              </span>
              {p}
            </li>
          ))
        }
      </ul>

      {
        niche.proof.clientLogo && (
          <div class="mt-9 flex items-center gap-4 border-t border-white/15 pt-6" data-reveal data-reveal-delay="180">
            <ClientLogo src={niche.proof.clientLogo} alt={niche.proof.clientName ?? ''} size="md" class="!border-transparent" />
            <p class="text-[0.95rem] leading-snug text-night-text">
              Ya trabajamos con <span class="font-semibold text-white">{niche.proof.clientName}</span>.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>
