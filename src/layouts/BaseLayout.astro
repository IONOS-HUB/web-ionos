---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { SITE, DEFAULT_WA_MESSAGE, WHATSAPP_NUMBER } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica (sin dominio). Por defecto la actual. */
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  waMessage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = '/imgs/og.png',
  ogType = 'website',
  waMessage = DEFAULT_WA_MESSAGE,
  noindex = false,
} = Astro.props;

const fullTitle = title.includes('IonosHub') ? title : `${title} | IonosHub`;
const canonical = new URL(path, SITE.url).href;
const ogImageAbs = new URL(ogImage, SITE.url).href;

// GA4 carga sólo con consentimiento (CookieConsent). El ID se puede sobreescribir por variable en Vercel (ver .env.example).
const gaId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined) || 'G-0Q8D7W836K';
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION as string | undefined;
const bingVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION as string | undefined;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'ProfessionalService'],
  name: 'IonosHub',
  url: SITE.url,
  logo: new URL('/imgs/logo.png', SITE.url).href,
  image: new URL('/imgs/og.png', SITE.url).href,
  email: SITE.email,
  telephone: `+${WHATSAPP_NUMBER}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Ibarra', addressRegion: 'Imbabura', addressCountry: 'EC' },
  areaServed: { '@type': 'Country', name: 'Ecuador' },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+${WHATSAPP_NUMBER}`,
    contactType: 'sales',
    availableLanguage: 'es',
  },
  sameAs: [SITE.social.linkedin, SITE.social.instagram, SITE.social.tiktok],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/imgs/icon.png" />
    <link rel="apple-touch-icon" href="/imgs/icon.png" />
    <meta name="theme-color" content="#0e5fcb" />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    {bingVerification && <meta name="msvalidate.01" content={bingVerification} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="IonosHub" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh flex flex-col">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-cobalt focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Nav />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat message={waMessage} />
    <CookieConsent gaId={gaId} />
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
