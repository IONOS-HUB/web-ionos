---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import Contact from '../../components/home/Contact.astro';
import { pillars } from '../../data/pillars';
import { sortByDate } from '../../lib/blog';

const posts = sortByDate(await getCollection('blog', ({ data }) => !data.draft));
const [latest, ...rest] = posts;
const wa = 'Hola IonosHub, leí su blog y quiero agendar un diagnóstico gratuito.';
---

<BaseLayout
  title="Blog y recursos · IA, automatización y datos para PyMEs en Ecuador"
  description="Artículos, guías y noticias de IonosHub sobre adopción de inteligencia artificial, automatización, seguridad de datos y marketing para pequeñas y medianas empresas en Ecuador."
  path="/blog-recursos"
  waMessage={wa}
>
  <section class="wrap py-16 lg:py-24">
    <div class="max-w-3xl" data-reveal>
      <h1 class="display-tight text-[clamp(2.4rem,5vw,4.2rem)] font-semibold text-ink">Lo que aprendemos automatizando negocios en Ecuador.</h1>
      <p class="mt-6 text-[clamp(1.1rem,1.5vw,1.3rem)] leading-relaxed text-ink-2">
        Guías, opiniones y noticias sobre IA, datos y automatización, escritas desde proyectos reales. Sin cifras que
        no podamos respaldar.
      </p>
    </div>

    {
      latest && (
        <div class="mt-12 grid gap-6 lg:mt-16 lg:grid-cols-12 lg:gap-8">
          <div class="lg:col-span-7" data-reveal>
            <PostCard post={latest} featured />
          </div>
          <ul class="grid gap-6 lg:col-span-5">
            {rest.slice(0, 2).map((p, i) => (
              <li data-reveal data-reveal-delay={(i + 1) * 70}>
                <PostCard post={p} />
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      rest.length > 2 && (
        <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {rest.slice(2).map((p, i) => (
            <li data-reveal data-reveal-delay={Math.min(i, 4) * 60}>
              <PostCard post={p} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="bg-ice-3 py-16 lg:py-24">
    <div class="wrap">
      <h2 class="display-tight text-[clamp(1.75rem,3vw,2.5rem)] font-semibold text-ink" data-reveal>Las preguntas que más nos hacen, por pilar.</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          pillars.map((p, i) => (
            <li data-reveal data-reveal-delay={i * 60}>
              <a href={p.route} class="group flex h-full items-start justify-between gap-4 rounded-[1.25rem] border border-line bg-canvas p-5 transition-colors hover:border-cobalt">
                <div class="min-w-0">
                  <p class="flex items-center gap-3 text-[1.05rem] font-semibold text-ink group-hover:text-cobalt">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ice text-cobalt-ink"><Icon name={p.id} size={18} /></span>
                    {p.short}
                  </p>
                  <p class="mt-3 text-[0.92rem] text-ink-2">{p.faqs.length} preguntas respondidas</p>
                </div>
                <Icon name="arrow-right" size={18} class="mt-1 shrink-0 text-cobalt transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Contact waMessage={wa} title="¿Quieres aplicarlo en tu negocio?" />
</BaseLayout>
