---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import Contact from '../../components/home/Contact.astro';
import { pillarById } from '../../data/pillars';
import { SITE } from '../../lib/site';
import { CATEGORY_LABEL, formatDate, postUrl, readingMinutes, resolveAuthor, sortByDate, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

interface Props {
  post: Post;
  all: Post[];
}
const { post, all } = Astro.props;
const { Content, headings } = await render(post);
const author = resolveAuthor(post.data.author);
const minutes = readingMinutes(post.body);
const pillar = post.data.pillar ? pillarById(post.data.pillar) : null;
const related = sortByDate(all.filter((p) => p.id !== post.id)).slice(0, 2);
const toc = headings.filter((h) => h.depth === 2);
const url = new URL(postUrl(post), SITE.url).href;
const wa = `Hola IonosHub, leí "${post.data.title}" y quiero agendar un diagnóstico gratuito.`;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': post.data.category === 'noticia' ? 'NewsArticle' : 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  inLanguage: 'es',
  mainEntityOfPage: url,
  image: new URL(post.data.cover ?? '/imgs/og.png', SITE.url).href,
  author: { '@type': author.photo ? 'Person' : 'Organization', name: author.name, url: new URL(author.url, SITE.url).href },
  publisher: { '@type': 'Organization', name: 'IonosHub', logo: { '@type': 'ImageObject', url: new URL('/imgs/logo.png', SITE.url).href } },
  keywords: post.data.tags.join(', '),
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Blog y recursos', item: new URL('/blog-recursos', SITE.url).href },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};
---

<BaseLayout title={post.data.title} description={post.data.description} path={postUrl(post)} ogImage={post.data.cover} ogType="article" waMessage={wa}>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    <meta property="article:author" content={author.name} />
    <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <article>
    <header class="wrap pt-12 lg:pt-20">
      <nav aria-label="Ruta" class="text-[0.9rem] text-ink-3" data-reveal>
        <a href="/" class="hover:text-cobalt">Inicio</a>
        <span class="mx-2 opacity-60">/</span>
        <a href="/blog-recursos" class="hover:text-cobalt">Blog y recursos</a>
      </nav>
      <div class="mt-6 flex flex-wrap items-center gap-2" data-reveal data-reveal-delay="40">
        <span class="chip chip-on">{CATEGORY_LABEL[post.data.category]}</span>
        {post.data.tags.map((t) => <span class="chip">{t}</span>)}
      </div>
      <h1 class="display-tight mt-5 max-w-4xl text-[clamp(2.2rem,4.5vw,3.8rem)] font-semibold text-ink" data-reveal data-reveal-delay="80">{post.data.title}</h1>
      <p class="mt-5 max-w-3xl text-[clamp(1.1rem,1.5vw,1.3rem)] leading-relaxed text-ink-2" data-reveal data-reveal-delay="120">{post.data.description}</p>

      <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4 border-y border-line-soft py-5" data-reveal data-reveal-delay="160">
        <a href={author.url} class="group flex items-center gap-3">
          {
            author.photo ? (
              <img src={author.photo} alt="" width="48" height="48" decoding="async" class="h-12 w-12 rounded-full object-cover object-top" />
            ) : (
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-ice text-cobalt-ink"><Icon name="users" size={20} /></span>
            )
          }
          <span class="leading-tight">
            <span class="block font-semibold text-ink group-hover:text-cobalt">{author.name}</span>
            <span class="block text-[0.85rem] text-ink-3">{author.role}</span>
          </span>
        </a>
        <p class="tnum text-[0.92rem] text-ink-3">
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          {post.data.updated && <span> · actualizado el {formatDate(post.data.updated)}</span>}
          <span> · {minutes} min de lectura</span>
        </p>
        {
          post.data.source && (
            <p class="inline-flex items-center gap-2 rounded-full border border-cobalt/30 bg-ice px-3.5 py-1.5 text-[0.85rem] font-semibold text-cobalt-ink">
              <Icon name="globe" size={14} />
              {post.data.source.url ? <a href={post.data.source.url} target="_blank" rel="noopener noreferrer">En colaboración con {post.data.source.name}</a> : `En colaboración con ${post.data.source.name}`}
            </p>
          )
        }
      </div>

      {
        post.data.cover && (
          <figure class="mt-10 overflow-hidden rounded-[1.5rem] border border-line" data-reveal data-reveal-delay="200">
            <img src={post.data.cover} alt={post.data.coverAlt ?? ''} width="1600" height="900" decoding="async" class="aspect-[16/9] w-full object-cover" />
          </figure>
        )
      }
    </header>

    <div class="wrap grid gap-12 py-12 lg:grid-cols-12 lg:gap-16 lg:py-16">
      {
        toc.length > 2 && (
          <aside class="lg:col-span-3 lg:order-2">
            <nav aria-label="Contenido del artículo" class="lg:sticky lg:top-24" data-reveal>
              <p class="text-[0.8rem] font-semibold uppercase tracking-wide text-ink-3">En este artículo</p>
              <ol class="mt-3 flex flex-col gap-2 border-l border-line pl-4 text-[0.95rem]">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="text-ink-2 hover:text-cobalt">{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
      <div class:list={['prose', toc.length > 2 ? 'lg:col-span-9 lg:order-1' : 'lg:col-span-9']} data-reveal data-reveal-delay="60">
        <Content />

        {
          pillar && (
            <aside class="not-prose mt-14 rounded-[1.5rem] bg-cobalt p-7 text-white lg:p-9">
              <p class="text-[0.8rem] font-semibold uppercase tracking-wide text-ice">Cómo lo aplicamos</p>
              <p class="display-tight mt-3 text-[clamp(1.5rem,2.6vw,2.1rem)] font-semibold">{pillar.title}</p>
              <p class="mt-3 max-w-2xl text-[1.05rem] leading-relaxed text-ice">{pillar.tagline}</p>
              <div class="mt-6 flex flex-col gap-3 sm:flex-row">
                <a href={pillar.route} class="btn btn-on-dark">
                  Ver el pilar
                  <Icon name="arrow-right" size={18} />
                </a>
                <a href="#contacto" class="btn border border-white/40 text-white hover:bg-white/10">Agendar diagnóstico gratis</a>
              </div>
            </aside>
          )
        }
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="bg-ice-3 py-16 lg:py-20">
        <div class="wrap">
          <h2 class="display-tight text-[clamp(1.75rem,3vw,2.5rem)] font-semibold text-ink" data-reveal>Sigue leyendo.</h2>
          <ul class="mt-8 grid gap-6 lg:grid-cols-2">
            {related.map((p, i) => (
              <li data-reveal data-reveal-delay={i * 70}>
                <PostCard post={p} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Contact waMessage={wa} title="¿Quieres aplicarlo en tu negocio?" />
</BaseLayout>

<style is:global>
  /* Prosa del artículo: medida de lectura, jerarquía por peso, enlaces cobalto. */
  .prose {
    max-width: 68ch;
    font-size: 1.08rem;
    line-height: 1.75;
    color: var(--color-ink-2);
  }
  .prose > p:first-child {
    font-size: 1.2rem;
    color: var(--color-ink);
  }
  .prose p {
    margin-top: 1.1rem;
  }
  .prose h2 {
    margin-top: 2.75rem;
    font-size: 1.7rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--color-ink);
    scroll-margin-top: 6rem;
  }
  .prose h3 {
    margin-top: 2rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .prose ul,
  .prose ol {
    margin-top: 0.9rem;
    padding-left: 1.4rem;
  }
  .prose ul {
    list-style: disc;
  }
  .prose ol {
    list-style: decimal;
  }
  .prose li {
    margin-top: 0.45rem;
    padding-left: 0.2rem;
  }
  .prose li::marker {
    color: var(--color-cobalt);
    font-weight: 600;
  }
  .prose strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .prose a {
    color: var(--color-cobalt);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .prose a:hover {
    color: var(--color-cobalt-deep);
  }
  .prose blockquote {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: var(--color-ice-3);
    border: 1px solid var(--color-ice-2);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-cobalt-ink);
    text-wrap: pretty;
  }
  .prose blockquote p {
    margin: 0;
  }
  .prose img {
    margin-top: 1.5rem;
    border-radius: 1.25rem;
    border: 1px solid var(--color-line);
  }
  .prose hr {
    margin: 2.5rem 0;
    border-color: var(--color-line-soft);
  }
  .prose code {
    font-size: 0.92em;
    padding: 0.1em 0.4em;
    border-radius: 0.4rem;
    background: var(--color-ice);
    color: var(--color-cobalt-ink);
  }
  .prose table {
    margin-top: 1.25rem;
    width: 100%;
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
  }
  .prose th,
  .prose td {
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-line-soft);
    text-align: left;
  }
  .prose th {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.025em;
    color: var(--color-ink-3);
  }
</style>
