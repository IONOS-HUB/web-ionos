---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/home/Contact.astro';
import { pillars } from '../data/pillars';

const wa = 'Hola IonosHub, quiero recibir recursos y novedades sobre IA y automatización para mi negocio.';
---

<BaseLayout
  title="Blog y recursos · IA, automatización y marketing para PyMEs"
  description="Guías y recursos de IonosHub sobre inteligencia artificial, automatizaciones, marketing en Meta y software a medida para pequeñas y medianas empresas en Ecuador."
  path="/blog-recursos"
  waMessage={wa}
>
  <section class="wrap py-16 lg:py-24">
    <div class="max-w-3xl" data-reveal>
      <h1 class="display-tight text-[clamp(2.4rem,5vw,4.2rem)] font-semibold text-ink">Recursos para decidir con datos.</h1>
      <p class="mt-6 text-[clamp(1.1rem,1.5vw,1.3rem)] leading-relaxed text-ink-2">
        Estamos preparando guías prácticas sobre los cuatro pilares. Mientras tanto, cada página de pilar responde las
        preguntas que más nos hacen, y por WhatsApp te orientamos sin costo.
      </p>
    </div>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        pillars.map((p, i) => (
          <li data-reveal data-reveal-delay={i * 60}>
            <a href={p.route} class="group flex h-full items-start justify-between gap-6 rounded-[1.25rem] border border-line p-6 transition-colors hover:border-cobalt">
              <div>
                <p class="flex items-center gap-3 text-[1.2rem] font-semibold text-ink group-hover:text-cobalt">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ice text-cobalt-ink"><Icon name={p.id} size={18} /></span>
                  {p.title}
                </p>
                <p class="mt-3 text-[0.98rem] text-ink-2">{p.faqs.length} preguntas respondidas</p>
              </div>
              <Icon name="arrow-right" size={20} class="mt-1 shrink-0 text-cobalt transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1" />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Contact waMessage={wa} title="¿Necesitas orientación ahora?" />
</BaseLayout>
