---
/**
 * Agenda · Software a medida. Página de registro "speed to lead" para el anuncio de software a medida: el
 * titular repite su gancho y la sección del medio cuenta cómo se construye, con capturas de sistemas reales.
 * El texto y el formulario salen de `src/data/landings.ts`; el lead llega a GHL por `/api/speed-to-lead` con
 * `variante: software`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Registro from '../../components/landing/Registro.astro';
import { getLanding } from '../../data/landings';

const landing = getLanding('software');
---

<BaseLayout title={landing.metaTitle} description={landing.metaDescription} path={landing.route} waMessage={landing.waMessage} noindex landing>
  <Registro landing={landing} />
</BaseLayout>
