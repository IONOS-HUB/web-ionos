---
/**
 * Agenda · Instituciones educativas. Página de registro "speed to lead" del nicho `institutos`, con la
 * demostración del sector y el campo noche con video (public/videos/landings/instituciones.*).
 * El texto sale de `src/data/landings.ts`; el lead llega a GHL con `variante: instituciones`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Registro from '../../components/landing/Registro.astro';
import { getLanding } from '../../data/landings';
import { nicheById } from '../../data/niches';

const landing = getLanding('instituciones');
const niche = nicheById('institutos')!;
---

<BaseLayout title={landing.metaTitle} description={landing.metaDescription} path={landing.route} waMessage={landing.waMessage} noindex landing nicho={niche.id}>
  <Registro landing={landing} niche={niche} />
</BaseLayout>
