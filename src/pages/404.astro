---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { pillars } from '../data/pillars';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o cambió de lugar." noindex>
  <section class="wrap py-24 lg:py-32">
    <div class="max-w-2xl">
      <h1 class="display-tight text-[clamp(2.4rem,5vw,4.2rem)] font-semibold text-ink">Esta página no existe, pero tu negocio sí.</h1>
      <p class="mt-6 text-[clamp(1.1rem,1.5vw,1.3rem)] leading-relaxed text-ink-2">
        <span class="tnum font-semibold text-cobalt">Error 404.</span> Es posible que el enlace haya cambiado. Estos son los caminos que sí llevan a algún lado.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-primary">
          Ir al inicio
          <Icon name="arrow-right" size={18} />
        </a>
        <a href="/#contacto" class="btn btn-ghost">Agendar diagnóstico gratis</a>
      </div>
    </div>
    <ul class="mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        pillars.map((p) => (
          <li>
            <a href={p.route} class="flex items-center gap-3 rounded-[1.25rem] border border-line p-4 hover:border-cobalt">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-ice text-cobalt-ink"><Icon name={p.id} size={20} /></span>
              <span class="text-[1rem] font-semibold text-ink">{p.title}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
