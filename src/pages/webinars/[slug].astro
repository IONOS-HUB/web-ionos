---
/**
 * Página de un webinar. Es la plantilla: todo sale de `src/data/webinars.ts`, así que publicar una
 * edición nueva no toca este archivo (ver docs/WEBINARS.md).
 *
 * Anatomía: campo de cobalto con la identidad del evento y la ventanilla de registro encima, agenda
 * como ventanilla de filas, qué te llevas, para quién es y quién lo da.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import WebinarForm from '../../components/islands/WebinarForm.tsx';
import WebinarCountdown from '../../components/webinars/WebinarCountdown.astro';
import WebinarCard from '../../components/webinars/WebinarCard.astro';
import {
  webinars,
  isUpcoming,
  formatWebinarDate,
  formatWebinarTime,
  sortedWebinars,
  type Webinar,
} from '../../data/webinars';
import { SITE, waLink } from '../../lib/site';

export function getStaticPaths() {
  return webinars.map((webinar) => ({ params: { slug: webinar.slug }, props: { webinar } }));
}

interface Props {
  webinar: Webinar;
}
const { webinar } = Astro.props;
const proximo = isUpcoming(webinar);
const abierto = proximo && webinar.registrationOpen;
const fecha = formatWebinarDate(webinar.startsAt, { year: true });
const hora = formatWebinarTime(webinar.startsAt);
const wa = `Hola IonosHub, me interesa el webinar "${webinar.title}".`;

// Otras ediciones para el pie de página, sin repetir la actual.
const { proximos, pasados } = sortedWebinars();
const otras = [...proximos, ...pasados].filter((w) => w.slug !== webinar.slug).slice(0, 3);

const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: webinar.title,
  description: webinar.summary,
  startDate: webinar.startsAt,
  eventAttendanceMode: 'https://schema.org/OnlineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  inLanguage: 'es-EC',
  location: {
    '@type': 'VirtualLocation',
    url: new URL(`/webinars/${webinar.slug}`, SITE.url).href,
  },
  organizer: webinar.hosts.map((name) => ({ '@type': 'Organization', name })),
  performer: webinar.sessions
    .filter((s) => s.speaker)
    .map((s) => ({ '@type': 'Person', name: s.speaker, jobTitle: s.speakerRole })),
  image: webinar.promoImage ? new URL(webinar.promoImage.src, SITE.url).href : undefined,
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: abierto ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut',
    url: new URL(`/webinars/${webinar.slug}`, SITE.url).href,
    validFrom: new Date().toISOString(),
  },
};
---

<BaseLayout
  title={webinar.metaTitle}
  description={webinar.metaDescription}
  path={`/webinars/${webinar.slug}`}
  ogImage={webinar.promoImage?.src}
  ogType="article"
  waMessage={wa}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(eventJsonLd)} />

  <!-- Campo de cobalto: identidad del evento y, encima, la ventanilla de registro. -->
  <section class="relative overflow-hidden bg-cobalt text-white">
    <div class="wb-mesh" aria-hidden="true"></div>

    <div class="wrap relative grid gap-10 py-14 lg:grid-cols-12 lg:gap-12 lg:py-20">
      <div class="min-w-0 lg:col-span-6 xl:col-span-7">
        <a href="/webinars" class="inline-flex items-center gap-2 text-[0.9rem] font-semibold text-white/75 transition-colors hover:text-white" data-reveal>
          <Icon name="arrow-right" size={15} class="rotate-180" />
          Webinars
        </a>

        <p class="mt-6 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[0.95rem] font-semibold text-white/80" data-reveal>
          {webinar.hosts.map((h, i) => (
            <>
              {i > 0 && <span aria-hidden="true" class="text-white/40">×</span>}
              <span>{h}</span>
            </>
          ))}
        </p>

        <h1 class="display-tight mt-4 text-[clamp(2.3rem,4.6vw,3.9rem)] font-semibold [text-wrap:balance]" data-reveal data-reveal-delay="60">
          {webinar.title}
        </h1>
        <p class="mt-5 max-w-xl text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-white/80" data-reveal data-reveal-delay="110">
          {webinar.tagline}
        </p>

        <dl class="mt-8 flex flex-wrap gap-x-8 gap-y-4" data-reveal data-reveal-delay="150">
          <div>
            <dt class="text-[0.72rem] font-semibold uppercase tracking-wide text-white/55">Cuándo</dt>
            <dd class="mt-1 text-[1.02rem] font-semibold first-letter:uppercase">{fecha}</dd>
          </div>
          <div>
            <dt class="text-[0.72rem] font-semibold uppercase tracking-wide text-white/55">Hora</dt>
            <dd class="tnum mt-1 text-[1.02rem] font-semibold">{hora} · {webinar.timezone}</dd>
          </div>
          <div>
            <dt class="text-[0.72rem] font-semibold uppercase tracking-wide text-white/55">Dónde</dt>
            <dd class="mt-1 text-[1.02rem] font-semibold">{webinar.format}</dd>
          </div>
          <div>
            <dt class="text-[0.72rem] font-semibold uppercase tracking-wide text-white/55">Costo</dt>
            <dd class="mt-1 text-[1.02rem] font-semibold">{webinar.price}</dd>
          </div>
        </dl>

        {proximo && <WebinarCountdown startsAt={webinar.startsAt} class="mt-8" />}
      </div>

      <div class="min-w-0 lg:col-span-6 xl:col-span-5" data-reveal data-reveal-delay="120">
        <div class="overflow-hidden rounded-[1.75rem] border border-line bg-canvas text-ink shadow-phone" id="registro">
          <div class="flex items-center gap-3 border-b border-line-soft bg-ice-3 px-6 py-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cobalt text-white">
              <Icon name={abierto ? 'users' : 'check'} size={17} />
            </span>
            <span class="min-w-0 leading-tight">
              <span class="block text-[0.98rem] font-semibold text-ink">{abierto ? 'Reserva tu lugar' : 'Edición finalizada'}</span>
              <span class="block text-[0.8rem] text-ink-3">{abierto ? 'En línea · te enviamos el acceso por WhatsApp' : 'El registro ya está cerrado'}</span>
            </span>
          </div>

          <div class="p-6 sm:p-7">
            {
              abierto ? (
                <WebinarForm client:visible slug={webinar.slug} titulo={webinar.title} comunidad={webinar.whatsappCommunity} />
              ) : (
                <div class="flex flex-col gap-4">
                  <p class="text-[1.02rem] leading-relaxed text-ink-2">
                    Esta edición ya se emitió. Déjanos tu contacto y te avisamos de la próxima, o escríbenos si
                    quieres aplicar lo que se trató en tu negocio.
                  </p>
                  <a href="/#contacto" class="btn btn-primary w-full">
                    Avísenme del próximo
                    <Icon name="arrow-right" size={18} />
                  </a>
                  <a href={waLink(wa)} target="_blank" rel="noopener noreferrer" class="btn btn-ghost w-full">
                    <Icon name="whatsapp" size={18} />
                    Escribir por WhatsApp
                  </a>
                </div>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Agenda como ventanilla: una fila por sesión. -->
  <section class="wrap py-16 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="min-w-0 lg:col-span-5" data-reveal>
        <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">
          {webinar.sessions.length === 2 ? 'Dos ponencias, un solo registro.' : 'La agenda del webinar.'}
        </h2>
        <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2">{webinar.summary}</p>

        {
          abierto && (
            <a href="#registro" class="btn btn-primary mt-8">
              Reservar mi lugar
              <Icon name="arrow-right" size={18} />
            </a>
          )
        }
      </div>

      <div class="min-w-0 lg:col-span-7" data-reveal data-reveal-delay="100">
        <div class="overflow-hidden rounded-[1.5rem] border border-line bg-canvas shadow-lift">
          <div class="flex items-center gap-3 bg-cobalt px-5 py-3.5 text-white">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15"><Icon name="clock" size={17} /></span>
            <span class="text-[0.98rem] font-semibold">Agenda</span>
            <span class="tnum ml-auto text-[0.8rem] text-white/70">{hora} · {webinar.timezone}</span>
          </div>
          <ol class="divide-y divide-line-soft">
            {
              webinar.sessions.map((s) => (
                <li class="flex items-start gap-4 px-5 py-5">
                  <span class="mt-0.5 shrink-0 rounded-full bg-ice px-2.5 py-1 text-[0.72rem] font-semibold uppercase tracking-wide text-cobalt-ink">
                    {s.label}
                  </span>
                  <div class="min-w-0">
                    <p class="text-[1.08rem] font-semibold leading-tight text-ink">{s.title}</p>
                    {s.speaker && (
                      <p class="mt-1.5 text-[0.98rem] font-semibold text-cobalt-ink">
                        {s.speaker}
                        {s.speakerRole && <span class="font-normal text-ink-3"> · {s.speakerRole}</span>}
                      </p>
                    )}
                    <p class="mt-1 text-[0.9rem] text-ink-3">
                      {s.host}
                      {s.moderator && <span> · Modera {s.moderator}</span>}
                    </p>
                    {s.detail && <p class="mt-2 text-[0.98rem] leading-relaxed text-ink-2">{s.detail}</p>}
                  </div>
                </li>
              ))
            }
          </ol>
          <div class="bg-ice-3 px-5 py-3 text-[0.8rem] text-ink-3">
            {webinar.format} · {webinar.price} · Organizan {webinar.hosts.join(' y ')}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Qué te llevas y para quién es -->
  <section class="bg-ice-3 py-16 lg:py-24">
    <div class="wrap grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div class="min-w-0" data-reveal>
        <h2 class="display-tight text-[clamp(1.75rem,3vw,2.5rem)] font-semibold text-ink">Qué te llevas</h2>
        <ul class="mt-7 flex flex-col gap-4">
          {
            webinar.takeaways.map((t) => (
              <li class="flex items-start gap-3.5">
                <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cobalt text-white">
                  <Icon name="check" size={16} />
                </span>
                <span class="text-[1.02rem] leading-relaxed text-ink">{t}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="min-w-0" data-reveal data-reveal-delay="90">
        <h2 class="display-tight text-[clamp(1.75rem,3vw,2.5rem)] font-semibold text-ink">Para quién es</h2>
        <ul class="mt-7 flex flex-col gap-3">
          {
            webinar.audience.map((a) => (
              <li class="flex items-start gap-3.5 rounded-[1.25rem] border border-line bg-canvas px-5 py-4">
                <Icon name="users" size={18} class="mt-0.5 shrink-0 text-cobalt-ink" />
                <span class="text-[1rem] leading-relaxed text-ink-2">{a}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {
    webinar.recap && (
      <section class="wrap py-16 lg:py-24">
        <div class="max-w-3xl" data-reveal>
          <h2 class="display-tight text-[clamp(1.75rem,3vw,2.5rem)] font-semibold text-ink">Cómo estuvo</h2>
          <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2">{webinar.recap.summary}</p>
          {webinar.recap.videoUrl && (
            <a href={webinar.recap.videoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-8">
              Ver la grabación
              <Icon name="arrow-up-right" size={18} />
            </a>
          )}
        </div>
      </section>
    )
  }

  {
    otras.length > 0 && (
      <section class="wrap py-16 lg:py-24">
        <h2 class="display-tight text-[clamp(1.75rem,3vw,2.5rem)] font-semibold text-ink" data-reveal>Otras ediciones</h2>
        <ul class="mx-auto mt-8 grid max-w-5xl gap-6 sm:grid-cols-2">
          {otras.map((w, i) => (
            <li data-reveal data-reveal-delay={Math.min(i, 3) * 70}>
              <WebinarCard webinar={w} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    webinar.organizerLogos && webinar.organizerLogos.length > 0 && (
      <section class="wrap pb-4">
        <p class="text-[0.72rem] font-semibold uppercase tracking-wide text-ink-3" data-reveal>Organizan</p>
        <ul class="mt-5 flex flex-wrap items-stretch gap-4" data-reveal data-reveal-delay="60">
          {webinar.organizerLogos.map((logo) => (
            <li class="flex h-20 w-40 items-center justify-center overflow-hidden rounded-[1.25rem] border border-line bg-canvas px-5 py-4">
              <img
                src={logo.src}
                alt={logo.alt}
                width={logo.width}
                height={logo.height}
                loading="lazy"
                decoding="async"
                class="max-h-full w-auto object-contain"
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Cierre: del webinar al diagnóstico -->
  <section class="wrap pb-20 lg:pb-28">
    <div class="overflow-hidden rounded-[1.75rem] bg-night px-7 py-12 text-white sm:px-12 lg:py-16" data-reveal>
      <div class="max-w-2xl">
        <h2 class="display-tight text-[clamp(1.85rem,3.4vw,2.75rem)] font-semibold">
          ¿Prefieres que lo apliquemos en tu negocio?
        </h2>
        <p class="mt-5 text-[1.05rem] leading-relaxed text-night-text">
          El webinar te da el panorama. El diagnóstico gratuito de 30 minutos te dice qué automatizar primero en tu
          operación y en qué orden, sin compromiso de compra.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/#contacto" class="btn btn-on-dark">
            Agendar diagnóstico gratis
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={waLink(wa)} target="_blank" rel="noopener noreferrer" class="btn btn-ghost !text-white hover:!bg-night-2">
            <Icon name="whatsapp" size={18} />
            Escribir por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Malla de nodos del campo cobalto: la misma idea de red que ya usa el ecosistema, en grande. */
  .wb-mesh {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(42rem 26rem at 88% -10%, rgb(63 134 230 / 0.55), transparent 70%),
      radial-gradient(30rem 22rem at 4% 108%, rgb(10 71 160 / 0.55), transparent 72%);
  }
</style>
