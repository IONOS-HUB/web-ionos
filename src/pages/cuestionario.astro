---
/**
 * Cuestionarios para clientes, uno por servicio (página web, software, marketing, CRM, agente de IA). Oculta
 * como las landings de pauta: se llega por el enlace que enviamos al cliente, ningún enlace del sitio apunta
 * aquí, es `noindex` y no está en el sitemap.
 *
 * - `?c=<id de contacto de GHL>`: enlace personal que envía el CRM. Llena «Tus datos» y no pide clave.
 * - `?s=<web|software|marketing|crm|ia>`: elige el servicio. Sin él, lo elige el CRM o la persona.
 * - Sin `?c=`, pide la clave de `CUESTIONARIO_CLAVE` antes de empezar.
 *
 * Las preguntas viven en `src/data/cuestionarios/`; el envío va a `/api/cuestionario` → n8n, que escribe el
 * PRD con Claude, lo guarda en Google Drive y cierra el ciclo en GHL. Guía: docs/CUESTIONARIOS.md.
 * `/cuestionario-web` (el primer enlace, sólo de página web) redirige aquí con `?s=web`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Cuestionario from '../components/islands/Cuestionario.tsx';
import Icon from '../components/Icon.astro';
import { waLink } from '../lib/site';

const waMessage = 'Hola IonosHub, tengo una duda con el cuestionario de mi proyecto.';
---

<BaseLayout
  title="Cuestionario para tu proyecto"
  description="Cuéntanos tu idea con tus propias palabras: el cuestionario con el que IonosHub prepara la propuesta de tu proyecto."
  path="/cuestionario"
  waMessage={waMessage}
  noindex
  interno
>
  <header class="sticky top-0 z-30 border-b border-line-soft bg-canvas/90 backdrop-blur-md">
    <div class="wrap flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
      <img src="/imgs/logo.webp" alt="IonosHub" width="463" height="140" class="h-9 w-auto lg:h-10" decoding="async" fetchpriority="high" />
      <p class="flex items-center gap-2 text-[0.92rem] text-ink-2">
        <Icon name="clock" size={16} class="text-cobalt" />
        <span><span class="hidden sm:inline">Te tomará entre </span>15–30 min</span>
      </p>
    </div>
  </header>

  <section class="min-h-[calc(100dvh-4rem)] bg-ice-3 lg:min-h-[calc(100dvh-4.5rem)]">
    <div id="cuestionario" class="wrap scroll-mt-24 py-10 lg:py-16">
      <Cuestionario client:load waHref={waLink(waMessage)} />
    </div>
  </section>
</BaseLayout>

<style>
  /* En móvil, con el teclado abierto, el flotante de WhatsApp no tapa el campo que se escribe. */
  @media (max-width: 1023px) {
    :global(body:has(#cuestionario :focus) [data-float-stack]) {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
