---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Contact from '../components/home/Contact.astro';
import { team } from '../data/team';

const areas = ['Dirección', 'Desarrollo', 'Automatizaciones', 'Marketing'] as const;
const wa = 'Hola IonosHub, quiero conocer más del equipo y agendar un diagnóstico gratuito.';
---

<BaseLayout
  title="Equipo IonosHub · Dirección, desarrollo, automatizaciones y marketing en Ibarra"
  description="Conoce al equipo de IonosHub: dirección, desarrollo, automatizaciones y marketing bajo un mismo techo en Ibarra, Ecuador."
  path="/equipo"
  waMessage={wa}
>
  <section class="wrap py-16 lg:py-24">
    <div class="max-w-3xl" data-reveal>
      <h1 class="display-tight text-[clamp(2.4rem,5vw,4.2rem)] font-semibold text-ink">Las personas detrás de IONIC y de cada sistema.</h1>
      <p class="mt-6 text-[clamp(1.1rem,1.5vw,1.3rem)] leading-relaxed text-ink-2">
        Somos un equipo ecuatoriano con sede en Ibarra. Dirección, desarrollo, automatizaciones y marketing trabajan
        juntos en cada proyecto, así que la persona que te atiende conoce tu negocio.
      </p>
    </div>
  </section>

  {
    areas.map((area, ai) => {
      const members = team.filter((m) => m.area === area);
      if (!members.length) return null;
      return (
        <section class:list={['py-14 lg:py-20', ai % 2 === 1 && 'bg-ice-3']}>
          <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
            <div class="lg:col-span-4" data-reveal>
              <h2 class="display-tight text-[clamp(1.5rem,2.2vw,2rem)] font-semibold text-ink">{area}</h2>
            </div>
            <ul class="grid gap-6 sm:grid-cols-2 lg:col-span-8">
              {members.map((m, i) => (
                <li class="grid gap-5 rounded-[1.5rem] border border-line bg-canvas p-5 sm:grid-cols-[9rem_1fr] sm:items-start" data-reveal data-reveal-delay={i * 70}>
                  <img src={m.photo} alt={`${m.name}, ${m.role}`} width="360" height="450" loading="lazy" decoding="async" class="aspect-[4/5] w-full rounded-[1rem] object-cover object-top grayscale contrast-[1.05] transition-[filter] duration-700 hover:grayscale-0" />
                  <div>
                    <h3 class="text-[1.3rem] font-semibold leading-tight text-ink">{m.name}</h3>
                    <p class="mt-1 text-[0.95rem] font-medium text-cobalt-ink">{m.role}</p>
                    <p class="mt-3 text-[1rem] leading-relaxed text-ink-2">{m.expertise}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    })
  }

  <section class="wrap py-16 lg:py-20">
    <div class="flex flex-col items-start gap-6 rounded-[1.75rem] bg-cobalt p-8 text-white sm:flex-row sm:items-center sm:justify-between lg:p-12" data-reveal>
      <div class="max-w-xl">
        <h2 class="display-tight text-[clamp(1.75rem,3vw,2.5rem)] font-semibold">¿Hablamos de tu negocio?</h2>
        <p class="mt-3 text-[1.05rem] text-ice">Un diagnóstico de 30 minutos con el equipo. Sin compromiso de compra.</p>
      </div>
      <a href="#contacto" class="btn btn-on-dark shrink-0">
        Agendar diagnóstico gratis
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>

  <Contact waMessage={wa} />
</BaseLayout>
