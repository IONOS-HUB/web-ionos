---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import FAQ from '../../components/home/FAQ.astro';
import Contact from '../../components/home/Contact.astro';
import PillarDemo from '../../components/demos/PillarDemo.astro';
import { pillars, type Pillar } from '../../data/pillars';
import { getCaseBySlug } from '../../data/cases';
import { waLink } from '../../lib/site';

export function getStaticPaths() {
  return pillars.map((p) => ({ params: { slug: p.slug }, props: { pillar: p } }));
}

interface Props {
  pillar: Pillar;
}
const { pillar } = Astro.props;
const cases = pillar.caseSlugs.map((s) => getCaseBySlug(s)!).filter(Boolean);
const others = pillars.filter((p) => p.id !== pillar.id);

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: pillar.title,
  description: pillar.metaDescription,
  provider: { '@type': 'Organization', name: 'IonosHub', url: 'https://ionoshub.net' },
  areaServed: 'EC',
  url: new URL(pillar.route, 'https://ionoshub.net').href,
};
---

<BaseLayout title={pillar.metaTitle} description={pillar.metaDescription} path={pillar.route} waMessage={pillar.waMessage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  </Fragment>

  <!-- Portada del pilar -->
  <section class="relative overflow-hidden bg-cobalt text-white">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full bg-cobalt-glow/30 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative grid gap-12 py-16 lg:grid-cols-12 lg:items-center lg:py-24">
      <div class="lg:col-span-7">
        <nav aria-label="Ruta" class="text-[0.9rem] text-ice" data-reveal>
          <a href="/" class="hover:text-white">Inicio</a>
          <span class="mx-2 opacity-60">/</span>
          <a href="/#ecosistema" class="hover:text-white">Pilares</a>
          <span class="mx-2 opacity-60">/</span>
          <span class="text-white">{pillar.short}</span>
        </nav>
        <h1 class="display-tight mt-5 text-[clamp(2.4rem,5vw,4.2rem)] font-semibold" data-reveal data-reveal-delay="60">{pillar.title}</h1>
        <p class="mt-5 max-w-2xl text-[clamp(1.15rem,1.7vw,1.5rem)] leading-relaxed text-ice" data-reveal data-reveal-delay="120">{pillar.tagline}</p>
        <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-white/85" data-reveal data-reveal-delay="160">{pillar.problem}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal data-reveal-delay="220">
          <a href="#contacto" class="btn btn-on-dark">
            Agendar diagnóstico gratis
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={waLink(pillar.waMessage)} target="_blank" rel="noopener noreferrer" class="btn border border-white/40 text-white hover:bg-white/10">
            <Icon name="whatsapp" size={18} />
            Preguntar por WhatsApp
          </a>
        </div>
      </div>

      <div class="text-ink lg:col-span-5" data-reveal data-reveal-delay="140">
        <PillarDemo pillar={pillar.id} />
      </div>
    </div>
  </section>

  <!-- Qué incluye -->
  <section class="wrap py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">Qué incluye.</h2>
        <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2">
          Todo lo que activamos dentro de este pilar. El alcance exacto se define contigo en el diagnóstico.
        </p>
        {
          pillar.proof && (
            <p class="mt-8 flex items-start gap-3 rounded-2xl border border-ice-2 bg-ice-3 p-5 text-[1rem] leading-relaxed text-cobalt-ink">
              <Icon name="shield" size={20} class="mt-0.5 shrink-0" />
              {pillar.proof}
            </p>
          )
        }
      </div>
      <ul class="divide-y divide-line lg:col-span-7">
        {
          pillar.includes.map((item, i) => (
            <li class="flex items-start gap-4 py-5" data-reveal data-reveal-delay={i * 50}>
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cobalt text-white"><Icon name="check" size={16} /></span>
              <p class="text-[1.15rem] leading-snug text-ink">{item}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Ejemplos -->
  <section class="bg-ice-3 py-20 lg:py-28">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">Así se ve en un negocio real.</h2>
      </div>
      <ol class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          pillar.examples.map((ex, i) => (
            <li class="flex gap-4 rounded-[1.5rem] border border-line bg-canvas p-7" data-reveal data-reveal-delay={i * 80}>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cobalt text-white"><Icon name="check" size={16} /></span>
              <p class="text-[1.15rem] leading-snug text-ink">{ex}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Casos -->
  {
    cases.length > 0 && (
      <section class="bg-night py-20 text-white lg:py-28">
        <div class="wrap">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
            <h2 class="display-tight max-w-2xl text-[clamp(2rem,4.2vw,3.25rem)] font-semibold">Lo que ya logramos con este pilar.</h2>
            <a href="/casos-de-exito" class="btn btn-on-dark shrink-0">
              Todos los casos
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
          <ul class="mt-12 grid gap-6 lg:grid-cols-3">
            {cases.map((c, i) => (
              <li class="flex flex-col rounded-[1.5rem] border border-night-line bg-night-2 p-7" data-reveal data-reveal-delay={i * 80}>
                <p class="display-tight tnum text-[clamp(2rem,3.4vw,2.8rem)] font-semibold leading-none">{c.highlight}</p>
                <p class="mt-5 text-[0.9rem] font-semibold uppercase tracking-wide text-night-text">Reto</p>
                <p class="mt-1 text-[1rem] leading-relaxed text-white/90">{c.challenge}</p>
                <p class="mt-4 text-[0.9rem] font-semibold uppercase tracking-wide text-night-text">Solución</p>
                <p class="mt-1 text-[1rem] leading-relaxed text-white/90">{c.solution}</p>
                <p class="mt-6 border-t border-night-line pt-4 text-[0.92rem]">
                  <span class="font-semibold">{c.client}</span>
                  <span class="text-night-text"> · {c.industry}</span>
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <FAQ items={pillar.faqs} title={`Dudas frecuentes sobre ${pillar.short === 'IA' ? 'inteligencia artificial' : pillar.short.toLowerCase()}.`} />

  <!-- Otros pilares -->
  <section class="wrap pb-20 lg:pb-28">
    <p class="text-[0.95rem] font-semibold uppercase tracking-wide text-ink-3" data-reveal>Se conecta con</p>
    <ul class="mt-5 grid gap-4 sm:grid-cols-3">
      {
        others.map((p, i) => (
          <li data-reveal data-reveal-delay={i * 60}>
            <a href={p.route} class="group flex h-full flex-col justify-between gap-6 rounded-[1.25rem] border border-line p-6 transition-colors hover:border-cobalt">
              <div>
                <p class="flex items-center gap-3 text-[1.15rem] font-semibold text-ink group-hover:text-cobalt">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ice text-cobalt-ink"><Icon name={p.id} size={18} /></span>
                  {p.title}
                </p>
                <p class="mt-3 text-[0.98rem] text-ink-2">{p.tagline}</p>
              </div>
              <span class="inline-flex items-center gap-2 text-[0.95rem] font-semibold text-cobalt-ink">
                Ver pilar <Icon name="arrow-right" size={16} class="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Contact defaultInterest={pillar.id} waMessage={pillar.waMessage} title={`Agenda tu diagnóstico de ${pillar.short === 'IA' ? 'IA' : pillar.short.toLowerCase()}.`} />
</BaseLayout>
