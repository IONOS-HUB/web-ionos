---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import FAQ from '../../components/home/FAQ.astro';
import Contact from '../../components/home/Contact.astro';
import PillarDemo from '../../components/demos/PillarDemo.astro';
import MediaGallery from '../../components/MediaGallery.astro';
import AgentStory from '../../components/AgentStory.astro';
import ClientLogo from '../../components/ClientLogo.astro';
import Photo from '../../components/Photo.astro';
import { pillars, type Pillar } from '../../data/pillars';
import { coverageGallery, landingsGallery, systemsGallery } from '../../data/photos';
import { getCaseBySlug } from '../../data/cases';
import { waLink } from '../../lib/site';

export function getStaticPaths() {
  return pillars.map((p) => ({ params: { slug: p.slug }, props: { pillar: p } }));
}

interface Props {
  pillar: Pillar;
}
const { pillar } = Astro.props;
const cases = pillar.caseSlugs.map((s) => getCaseBySlug(s)!).filter(Boolean);
const others = pillars.filter((p) => p.id !== pillar.id);

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: pillar.title,
  description: pillar.metaDescription,
  provider: { '@type': 'Organization', name: 'IonosHub', url: 'https://ionoshub.net' },
  areaServed: 'EC',
  url: new URL(pillar.route, 'https://ionoshub.net').href,
};
---

<BaseLayout title={pillar.metaTitle} description={pillar.metaDescription} path={pillar.route} waMessage={pillar.waMessage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  </Fragment>

  <!-- Portada del pilar -->
  <section class="relative overflow-hidden bg-cobalt text-white">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full bg-cobalt-glow/30 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative grid gap-12 py-16 lg:grid-cols-12 lg:items-center lg:py-24">
      <div class="lg:col-span-7">
        <nav aria-label="Ruta" class="text-[0.9rem] text-ice" data-reveal>
          <a href="/" class="hover:text-white">Inicio</a>
          <span class="mx-2 opacity-60">/</span>
          <a href="/#ecosistema" class="hover:text-white">Pilares</a>
          <span class="mx-2 opacity-60">/</span>
          <span class="text-white">{pillar.short}</span>
        </nav>
        <h1 class="display-tight mt-5 text-[clamp(2.4rem,5vw,4.2rem)] font-semibold" data-reveal data-reveal-delay="60">{pillar.title}</h1>
        <p class="mt-5 max-w-2xl text-[clamp(1.15rem,1.7vw,1.5rem)] leading-relaxed text-ice" data-reveal data-reveal-delay="120">{pillar.tagline}</p>
        <p class="mt-4 max-w-2xl text-[1.05rem] leading-relaxed text-white/85" data-reveal data-reveal-delay="160">{pillar.problem}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row" data-reveal data-reveal-delay="220">
          <a href="#contacto" class="btn btn-on-dark">
            Agendar diagnóstico gratis
            <Icon name="arrow-right" size={18} />
          </a>
          <a href={waLink(pillar.waMessage)} target="_blank" rel="noopener noreferrer" class="btn border border-white/40 text-white hover:bg-white/10">
            <Icon name="whatsapp" size={18} />
            Preguntar por WhatsApp
          </a>
        </div>
      </div>

      <div class="text-ink lg:col-span-5" data-reveal data-reveal-delay="140">
        <PillarDemo pillar={pillar.id} />
      </div>
    </div>
  </section>

  <!-- Qué incluye -->
  <section class="wrap py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5" data-reveal>
        <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">Qué incluye.</h2>
        <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2">
          Todo lo que activamos dentro de este pilar. El alcance exacto se define contigo en el diagnóstico.
        </p>
        {
          pillar.proof && (
            <p class="mt-8 flex items-start gap-3 rounded-2xl border border-ice-2 bg-ice-3 p-5 text-[1rem] leading-relaxed text-cobalt-ink">
              <Icon name="shield" size={20} class="mt-0.5 shrink-0" />
              {pillar.proof}
            </p>
          )
        }
      </div>
      <ul class="divide-y divide-line lg:col-span-7">
        {
          pillar.includes.map((item, i) => (
            <li class="flex items-start gap-4 py-5" data-reveal data-reveal-delay={i * 50}>
              <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-cobalt text-white"><Icon name="check" size={16} /></span>
              <p class="text-[1.15rem] leading-snug text-ink">{item}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Trabajo real · Marketing: cobertura de eventos (fotos) y landing pages (capturas) -->
  {
    pillar.id === 'marketing' && (
      <section class="wrap pb-20 lg:pb-28">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
          <div class="lg:col-span-4" data-reveal>
            <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">Cobertura de eventos, lista para publicar el mismo día.</h2>
            <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2">
              Fotografía y video profesional de tu evento: retratos, ambiente y detalle, editados y entregados para que
              salgan en tus redes cuando todavía se está hablando de él.
            </p>
            <p class="mt-4 text-[0.95rem] text-ink-3">Fotos reales de una cobertura de IonosHub.</p>
          </div>
          <div class="min-w-0 lg:col-span-8">
            <MediaGallery gallery={coverageGallery} />
          </div>
        </div>

        <div class="mt-16 grid gap-10 lg:mt-24 lg:grid-cols-12 lg:gap-16">
          <div class="lg:order-2 lg:col-span-4" data-reveal>
            <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">Landing pages que reciben la pauta y convierten.</h2>
            <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2">
              Una página por campaña, diseñada a la medida del negocio y con un solo objetivo: que el visitante escriba,
              reserve o agende. Conectadas al CRM unificado y atendidas por IONIC.
            </p>
            <p class="mt-4 text-[0.95rem] text-ink-3">Capturas reales de landing pages de clientes.</p>
          </div>
          <div class="min-w-0 lg:order-1 lg:col-span-8">
            <MediaGallery gallery={landingsGallery} variant="screen" />
          </div>
        </div>
      </section>
    )
  }

  <!-- Trabajo real · Automatizaciones: el agente de Daniela Vidal, paso a paso -->
  {
    pillar.id === 'automatizaciones' && (
      <section class="wrap pb-20 lg:pb-28">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-start lg:gap-16">
          <div class="lg:col-span-5" data-reveal>
            <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">Un agente que filtra, califica y entrega leads listos para cerrar.</h2>
            <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2">
              Para Daniela Vidal, asesora de seguros e inversiones, montamos un agente de IA que atiende su WhatsApp
              24/7: conversa con cada interesado, lo califica y lo deja registrado en el CRM unificado. Ella entra sólo a
              cerrar y cobrar, sin un equipo de atención.
            </p>
            <ul class="mt-7 flex flex-col gap-3">
              {
                [
                  'Filtra y califica cada lead, a cualquier hora',
                  'Lo registra en el CRM con etapa, origen y datos',
                  'La asesora entra sólo a cerrar y cobrar',
                ].map((t) => (
                  <li class="flex items-start gap-3 text-[1.02rem] text-ink">
                    <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-cobalt text-white"><Icon name="check" size={14} /></span>
                    {t}
                  </li>
                ))
              }
            </ul>
            <Photo id="dueno-local" aspect="aspect-[16/10]" class="mt-9" caption="Foto ilustrativa" />
          </div>
          <div class="min-w-0 lg:col-span-7">
            <AgentStory />
          </div>
        </div>
      </section>
    )
  }

  <!-- Trabajo real · Software: sistemas entregados (capturas) -->
  {
    pillar.id === 'software' && (
      <section class="wrap pb-20 lg:pb-28">
        <div class="max-w-3xl" data-reveal>
          <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">Sistemas entregados, funcionando en negocios reales.</h2>
          <p class="mt-5 text-[clamp(1.05rem,1.4vw,1.25rem)] leading-relaxed text-ink-2">
            Facturación electrónica, tiendas en línea, sistemas académicos y de gestión: capturas de sistemas que hoy usan
            nuestros clientes. Cada uno nació de un diagnóstico y de un alcance cerrado.
          </p>
        </div>
        <div class="mt-10 lg:mt-14">
          <MediaGallery gallery={systemsGallery} variant="screen" />
        </div>
      </section>
    )
  }

  <!-- Ejemplos -->
  <section class="bg-ice-3 py-20 lg:py-28">
    <div class="wrap">
      <div class="max-w-3xl" data-reveal>
        <h2 class="display-tight text-[clamp(2rem,4.2vw,3.25rem)] font-semibold text-ink">Así se ve en un negocio real.</h2>
      </div>
      <ol class="mt-12 grid gap-6 lg:grid-cols-3">
        {
          pillar.examples.map((ex, i) => (
            <li class="flex gap-4 rounded-[1.5rem] border border-line bg-canvas p-7" data-reveal data-reveal-delay={i * 80}>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-cobalt text-white"><Icon name="check" size={16} /></span>
              <p class="text-[1.15rem] leading-snug text-ink">{ex}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Casos -->
  {
    cases.length > 0 && (
      <section class="bg-night py-20 text-white lg:py-28">
        <div class="wrap">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal>
            <h2 class="display-tight max-w-2xl text-[clamp(2rem,4.2vw,3.25rem)] font-semibold">Lo que ya logramos con este pilar.</h2>
            <a href="/casos-de-exito" class="btn btn-on-dark shrink-0">
              Todos los casos
              <Icon name="arrow-right" size={18} />
            </a>
          </div>
          <!-- Filas editoriales: con un solo caso ocupa todo el ancho; con varios, se apilan divididos. -->
          <ol class="mt-12 divide-y divide-night-line border-y border-night-line lg:mt-16">
            {cases.map((c, i) => (
              <li class="grid gap-8 py-10 lg:grid-cols-12 lg:gap-12 lg:py-12" data-reveal data-reveal-delay={i * 80}>
                <div class="lg:col-span-5">
                  <div class="flex items-center gap-4">
                    {c.logo && <ClientLogo src={c.logo} alt="" size="lg" />}
                    <div class="min-w-0">
                      <p class="text-[1.15rem] font-semibold leading-tight">{c.client}</p>
                      <p class="mt-1 text-[0.95rem] text-night-text">{c.industry}</p>
                    </div>
                  </div>
                  {c.metric ? (
                    <p class="mt-8 flex flex-wrap items-end gap-x-4 gap-y-2">
                      <span class="tnum inline-flex items-baseline gap-2 pb-1.5 text-[1rem] font-medium text-night-text">
                        <span class="text-[0.75rem] uppercase tracking-wide">antes</span>
                        <span class="line-through decoration-night-text/50">{c.metric.before}</span>
                      </span>
                      <span class="display-tight tnum text-[clamp(2.8rem,5vw,4.4rem)] font-semibold leading-none">
                        {c.metric.after}
                        {c.metric.unit && <span class="ml-2 text-[0.4em] font-medium text-night-text">{c.metric.unit}</span>}
                      </span>
                    </p>
                  ) : (
                    <p class="display-tight mt-8 text-[clamp(2.2rem,4vw,3.4rem)] font-semibold leading-none">{c.highlight}</p>
                  )}
                </div>
                <dl class="grid gap-6 sm:grid-cols-3 lg:col-span-7">
                  {[
                    ['Reto', c.challenge],
                    ['Solución', c.solution],
                    ['Resultado', c.result],
                  ].map(([t, d]) => (
                    <div>
                      <dt class="text-[0.78rem] font-semibold uppercase tracking-wide text-night-text">{t}</dt>
                      <dd class="mt-2 text-[1rem] leading-relaxed text-white/90">{d}</dd>
                    </div>
                  ))}
                </dl>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <FAQ items={pillar.faqs} title={`Dudas frecuentes sobre ${pillar.short === 'IA' ? 'inteligencia artificial' : pillar.short.toLowerCase()}.`} />

  <!-- Otros pilares -->
  <section class="wrap pb-20 lg:pb-28">
    <p class="text-[0.95rem] font-semibold uppercase tracking-wide text-ink-3" data-reveal>Se conecta con</p>
    <ul class="mt-5 grid gap-4 sm:grid-cols-3">
      {
        others.map((p, i) => (
          <li data-reveal data-reveal-delay={i * 60}>
            <a href={p.route} class="group flex h-full flex-col justify-between gap-6 rounded-[1.25rem] border border-line p-6 transition-colors hover:border-cobalt">
              <div>
                <p class="flex items-center gap-3 text-[1.15rem] font-semibold text-ink group-hover:text-cobalt">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ice text-cobalt-ink"><Icon name={p.id} size={18} /></span>
                  {p.title}
                </p>
                <p class="mt-3 text-[0.98rem] text-ink-2">{p.tagline}</p>
              </div>
              <span class="inline-flex items-center gap-2 text-[0.95rem] font-semibold text-cobalt-ink">
                Ver pilar <Icon name="arrow-right" size={16} class="transition-transform duration-500 ease-[var(--ease-out-expo)] group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Contact defaultInterest={pillar.id} waMessage={pillar.waMessage} title={`Agenda tu diagnóstico de ${pillar.short === 'IA' ? 'IA' : pillar.short.toLowerCase()}.`} />
</BaseLayout>
