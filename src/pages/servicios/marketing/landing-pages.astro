---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import Contact from '../../../components/home/Contact.astro';
import { landingPages } from '../../../data/landing-pages';
import { srcsetFor } from '../../../lib/images';

const wa = 'Hola IonosHub, vi sus landing pages y quiero una para mi negocio.';
---

<BaseLayout
  title="Landing pages de clientes · IonosHub"
  description="Landing pages diseñadas por IonosHub para clientes reales en Ecuador: una página por campaña, conectada al CRM y lista para recibir la pauta."
  path="/servicios/marketing/landing-pages"
  waMessage={wa}
>
  <section class="wrap py-16 lg:py-24">
    <a href="/servicios/marketing" class="text-[0.95rem] font-semibold text-cobalt hover:underline">← Marketing</a>
    <div class="mt-6 max-w-3xl" data-reveal>
      <h1 class="display-tight text-[clamp(2.4rem,5vw,4.2rem)] font-semibold text-ink">Landing pages que hicimos para clientes reales.</h1>
      <p class="mt-6 text-[clamp(1.1rem,1.5vw,1.3rem)] leading-relaxed text-ink-2">
        Cada una está en línea: entra y mírala funcionando.
      </p>
    </div>

    <ul class="mt-14 grid gap-10 md:grid-cols-2">
      {
        landingPages.map((l) => {
          const src = `/imgs/landings/${l.id}.webp`;
          return (
            <li data-reveal>
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="group block">
                <img
                  src={src}
                  srcset={srcsetFor(src, 1366)}
                  sizes="(min-width: 768px) 50vw, 100vw"
                  alt={l.alt}
                  width="1366"
                  height="768"
                  loading="lazy"
                  decoding="async"
                  class="aspect-[1366/768] w-full rounded-2xl border border-line object-cover object-top shadow-sm transition group-hover:-translate-y-1"
                />
                <h2 class="mt-5 text-[1.4rem] font-semibold text-ink group-hover:text-cobalt">{l.nombre}</h2>
              </a>
              {l.descripcion && <p class="mt-2 leading-relaxed text-ink-2">{l.descripcion}</p>}
              <a href={l.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1 text-[0.95rem] font-semibold text-cobalt hover:underline">
                {new URL(l.url).hostname.replace(/^www\./, '')} <Icon name="arrow-up-right" size={14} />
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <Contact waMessage={wa} defaultInterest="marketing" />
</BaseLayout>
