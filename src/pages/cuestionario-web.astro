---
/**
 * Cuestionario de página web para clientes. Oculta como las landings de pauta: se llega por el enlace que
 * enviamos al cliente, ningún enlace del sitio apunta aquí, es `noindex` y no está en el sitemap. Pide la
 * clave de `CUESTIONARIO_CLAVE` antes de empezar.
 *
 * Las preguntas viven en `src/data/cuestionario.ts`; el envío va a `/api/cuestionario` → n8n, que escribe el
 * PRD con Claude y lo guarda en Google Drive. Guía: docs/CUESTIONARIO-WEB.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CuestionarioWeb from '../components/islands/CuestionarioWeb.tsx';
import Icon from '../components/Icon.astro';
import { waLink } from '../lib/site';

const waMessage = 'Hola IonosHub, tengo una duda con el cuestionario de mi página web.';
---

<BaseLayout
  title="Cuestionario para tu página web"
  description="Cuéntanos tu idea con tus propias palabras: el cuestionario con el que IonosHub prepara el plan de tu página web."
  path="/cuestionario-web"
  waMessage={waMessage}
  noindex
  interno
>
  <header class="sticky top-0 z-30 border-b border-line-soft bg-canvas/90 backdrop-blur-md">
    <div class="wrap flex h-16 items-center justify-between gap-4 lg:h-[4.5rem]">
      <img src="/imgs/logo.webp" alt="IonosHub" width="463" height="140" class="h-9 w-auto lg:h-10" decoding="async" fetchpriority="high" />
      <p class="flex items-center gap-2 text-[0.92rem] text-ink-2">
        <Icon name="clock" size={16} class="text-cobalt" />
        <span><span class="hidden sm:inline">Te tomará entre </span>20–30 min</span>
      </p>
    </div>
  </header>

  <section class="min-h-[calc(100dvh-4rem)] bg-ice-3 lg:min-h-[calc(100dvh-4.5rem)]">
    <div id="cuestionario" class="wrap scroll-mt-24 py-10 lg:py-16">
      <CuestionarioWeb client:load waHref={waLink(waMessage)} />
    </div>
  </section>
</BaseLayout>

<style>
  /* En móvil, con el teclado abierto, el flotante de WhatsApp no tapa el campo que se escribe. */
  @media (max-width: 1023px) {
    :global(body:has(#cuestionario :focus) [data-float-stack]) {
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
